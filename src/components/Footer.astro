---
/**
 * Site footer: medical disclaimer, sources and model credit, more links.
 * The disclaimer and credit must appear on every page (CLAUDE.md rules 1 and 3).
 */
import { getStrings, getRoutes, externalLinks, otherLanguagePath } from '../i18n';
const routes = getRoutes(Astro.currentLocale);

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
const t = getStrings(Astro.currentLocale).footer;
const links = [
  { href: routes.children, label: t.links.children },
  { href: routes.support, label: t.links.support },
  { href: routes.kit, label: t.links.kit },
  { href: routes.impact, label: t.links.impact },
  { href: routes.openSource, label: t.links.openSource },
  { href: routes.about, label: t.links.about },
  { href: routes.privacy, label: t.links.privacy },
];
const espanol = getStrings(Astro.currentLocale).header.espanol;
const otherLang = Astro.currentLocale === 'es' ? 'en' : 'es';
const otherHref = otherLanguagePath(Astro.url.pathname);
---

<footer class:list={['site-footer', { dark }]}>
  <div class="inner container">
    <p class="advice">
      <strong>{t.notAdvice}</strong>{' '}<span class="only-wide">{t.notAdviceRest.wide}</span><span class="only-narrow">{t.notAdviceRest.narrow}</span>
    </p>
    <p class="credit">
      {t.factsBefore} <a href={externalLinks.ninds}>{t.ninds}</a>{t.modelBefore} <a href={externalLinks.zAnatomy}>{t.zAnatomy}</a> {t.modelAfter}<span class="only-wide"> {t.personalProject}</span>
    </p>
    <nav class="more" aria-label={t.moreNavLabel}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={otherHref} lang={otherLang} hreflang={otherLang} data-other-lang>{espanol}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }
  .inner {
    padding-top: var(--s-40);
    padding-bottom: var(--s-40);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-32);
    font-size: 14px;
    color: var(--muted);
  }
  .advice,
  .credit {
    flex: 1 1 340px;
  }
  /* Dark variant (3D Explorer) */
  .dark {
    background: var(--x-panel);
    border-top-color: var(--x-border);
  }
  .dark .inner {
    color: var(--x-muted);
  }
  .dark .advice strong {
    color: var(--x-text);
  }
  .dark a {
    color: var(--x-accent);
  }
  .dark a:hover {
    color: var(--x-text);
  }
  .dark :focus-visible {
    outline-color: var(--x-accent);
  }

  .advice strong {
    color: var(--ink);
    font-weight: 600;
  }
  .more {
    flex: 1 1 100%;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-24);
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }

  /* Calm mode: larger footer text. */
  :global(:root[data-calm='on']) .inner {
    font-size: 16px;
  }

  @media (max-width: 720px) {
    .inner {
      padding-top: var(--s-24);
      padding-bottom: var(--s-24);
      flex-direction: column;
      flex-wrap: nowrap;
      gap: var(--s-8);
      font-size: 13px;
    }
    .advice,
    .credit {
      flex: none;
    }
    .more {
      flex: none;
      order: 1;
      column-gap: var(--s-16);
    }
    .credit {
      order: 2;
    }
    :global(:root[data-calm='on']) .inner {
      font-size: 16px;
    }
  }
</style>
