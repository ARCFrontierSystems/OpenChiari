---
/**
 * Shared <head> contents for every page. No third-party requests: fonts are bundled,
 * there are no external scripts or stylesheets.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { getStrings, otherLanguagePath } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
}

const t = getStrings(Astro.currentLocale);
const { title, description = t.metaDescription, themeColor = '#FFFFFF' } = Astro.props;
const pageTitle = title ? `${title} · ${t.siteName}` : t.siteName;
const site = Astro.site ?? 'https://openchiari.org';
const here = Astro.url.pathname;
const isSpanish = Astro.currentLocale === 'es';
const english = new URL(isSpanish ? otherLanguagePath(here) : here, site).href;
const spanish = new URL(isSpanish ? here : otherLanguagePath(here), site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content={themeColor} />
<link rel="icon" href="/brand/icon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/brand/icon-180.png" />
<!-- Lets people save the site to their phone and use it without a signal (public/sw.js, made at build time). -->
<link rel="manifest" href="/manifest.webmanifest" />
<!-- What a shared link shows (the logo on white). Absolute addresses, as link previews need them. -->
<meta property="og:site_name" content={t.siteName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={isSpanish ? 'es_US' : 'en_US'} />
<!-- The same page in the other language, for search engines. -->
<link rel="alternate" hreflang="en" href={english} />
<link rel="alternate" hreflang="es" href={spanish} />
<link rel="alternate" hreflang="x-default" href={english} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? 'https://openchiari.org').href} />
<meta property="og:image" content="https://openchiari.org/brand/share.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.siteName} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline>
  // Calm mode, decided before the page draws (no flash). Same key as src/lib/calm.ts.
  // Saved choice wins; with none, follow the system "reduce motion" setting.
  (function () {
    var saved = null;
    try { saved = localStorage.getItem('openchiari-calm'); } catch (e) {}
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (saved === 'on' || (saved !== 'off' && reduce)) document.documentElement.dataset.calm = 'on';
    // Dim mode, the same way: saved choice wins; with none, follow the system's dark-mode setting. Same key as src/lib/dim.ts.
    var dim = null;
    try { dim = localStorage.getItem('openchiari-dim'); } catch (e) {}
    var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (dim === 'on' || (dim !== 'off' && dark)) document.documentElement.dataset.dim = 'on';
  })();
</script>
<script>
  // Visits: totals only, never anything about the visitor (src/lib/count.ts).
  import { countVisit } from '../lib/count';
  countVisit();
  // Links that leave the site open in a new tab (src/lib/external-links.ts).
  import { openExternalLinksInNewTabs } from '../lib/external-links';
  if (document.body) openExternalLinksInNewTabs();
  else document.addEventListener('DOMContentLoaded', openExternalLinksInNewTabs);
  // The offline helper, on the real site only (tests and previews run without it).
  // Not inside another site's frame or on the embed page: people who never visited Open Chiari shouldn't get a copy.
  if ('serviceWorker' in navigator && location.hostname === 'openchiari.org' && window.top === window.self && !location.pathname.includes('/embed/'))
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  // Switching language keeps the view after the # (the same model view opens in the other language).
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>('a[data-other-lang]');
    if (link && location.hash) link.hash = location.hash;
  });
</script>
