---
/**
 * Shared <head> contents for every page. No third-party requests: fonts are bundled,
 * there are no external scripts or stylesheets.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { getStrings } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
}

const t = getStrings();
const { title, description = t.metaDescription, themeColor = '#FFFFFF' } = Astro.props;
const pageTitle = title ? `${title} · ${t.siteName}` : t.siteName;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content={themeColor} />
<link rel="icon" href="/brand/icon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/brand/icon-180.png" />
<!-- What a shared link shows (the logo on white). Absolute addresses, as link previews need them. -->
<meta property="og:site_name" content={t.siteName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? 'https://openchiari.org').href} />
<meta property="og:image" content="https://openchiari.org/brand/share.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.siteName} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline>
  // Calm mode, decided before the page draws (no flash). Same key as src/lib/calm.ts.
  // Saved choice wins; with none, follow the system "reduce motion" setting.
  (function () {
    var saved = null;
    try { saved = localStorage.getItem('openchiari-calm'); } catch (e) {}
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (saved === 'on' || (saved !== 'off' && reduce)) document.documentElement.dataset.calm = 'on';
  })();
</script>
<script>
  // Visits: totals only, never anything about the visitor (src/lib/count.ts).
  import { countVisit } from '../lib/count';
  countVisit();
</script>
