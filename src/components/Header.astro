---
/**
 * Site header. Desktop: brand, main nav, Español, Calm mode switch.
 * Phone and narrow screens: brand, Calm mode, and a Menu button that opens the nav.
 * Calm mode: a real switch (checkbox with role="switch"). On phones it looks like the
 * outlined button in HomePhone, and reads "Calm on" when on (HomeCalm). Logic is in src/lib/calm.ts.
 */
import { getStrings, getRoutes, otherLanguagePath } from '../i18n';
import TranslationNotice from './TranslationNotice.astro';
const routes = getRoutes(Astro.currentLocale);

const t = getStrings(Astro.currentLocale).header;
const calm = getStrings(Astro.currentLocale).calm;
// The four everyday tools (Matthew, Nov 5). Open model and Support are in the footer and in the Home tools.
const navItems = [
  { href: routes.explorer, label: t.nav.explorer },
  { href: routes.explain, label: t.nav.explain },
  { href: routes.prep, label: t.nav.prep },
  { href: routes.studies, label: t.nav.studies },
];
// "More": the other tools, in the Home page's order (minus the four above), as plain links. The group headings stay
// on Home only (Matthew, Nov 5).
const tools = getStrings(Astro.currentLocale).home.tools;
const inMenu = ['explorer', 'prep', 'explain', 'studies'];
const moreItems = tools.groups
  .flatMap((g) => g.pages)
  .filter((page) => !inMenu.includes(page))
  .map((page) => ({ href: routes[page as keyof typeof routes], label: tools.items.find((tool) => tool.page === page)!.title }));
const current = Astro.url.pathname;
// The language link opens this same page in the other language.
const otherLang = Astro.currentLocale === 'es' ? 'en' : 'es';
const otherHref = otherLanguagePath(current);
---

<TranslationNotice />
<header class="site-header">
  <div class="bar container">
    <a class="brand" href={routes.home}>
      <img class="brand-logo logo-light" src="/brand/logo-header.png" alt={getStrings(Astro.currentLocale).siteName} width="267" height="112" />
      <img class="brand-logo logo-dim" src="/brand/logo-header-dark.png" alt={getStrings(Astro.currentLocale).siteName} width="267" height="112" />
    </a>

    <nav class="nav-wide" aria-label={t.mainNavLabel}>
      {navItems.map((item) => (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      <div class="more">
        <button type="button" class="more-button" aria-expanded="false" aria-controls="more-panel">
          {t.more}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
        <div class="more-panel" id="more-panel" hidden>
          {moreItems.map((item) => (
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <a class="lang nav-wide-only" href={otherHref} lang={otherLang} hreflang={otherLang} data-other-lang>{t.espanol}</a>

    <label class="dim-toggle nav-wide-only">
      <input type="checkbox" role="switch" data-dim-switch aria-label={t.dimLabel} />
      <span aria-hidden="true">{t.dim}</span>
    </label>

    <label class="calm-toggle">
      <input type="checkbox" role="switch" data-calm-switch aria-label={t.calm} />
      <span class="calm-label-off" aria-hidden="true">{t.calm}</span>
      <span class="calm-label-on" aria-hidden="true">{calm.on}</span>
    </label>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <span class="visually-hidden">{t.menu}</span>
    </button>
  </div>

  <nav class="menu" id="site-menu" aria-label={t.mainNavLabel} hidden>
    {navItems.map((item) => (
      <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
    ))}
    {moreItems.map((item, i) => (
      <a class:list={{ 'menu-more-first': i === 0 }} href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href={otherHref} lang={otherLang} hreflang={otherLang} data-other-lang>{t.espanol}</a>
    <label class="menu-switch">
      <input type="checkbox" role="switch" data-dim-switch aria-label={t.dimLabel} />
      <span aria-hidden="true">{t.dim}</span>
    </label>
  </nav>
</header>

<script>
  import { bindCalmSwitches } from '../lib/calm';
  import { bindDimSwitches } from '../lib/dim';

  bindCalmSwitches();
  bindDimSwitches();

  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.getElementById('site-menu');
  if (button && menu) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        button.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        button.focus();
      }
    });
  }

  // "More": opens and closes with its button; Escape, a click elsewhere or moving focus away closes it.
  const more = document.querySelector<HTMLElement>('.more');
  const moreButton = document.querySelector<HTMLButtonElement>('.more-button');
  const morePanel = document.getElementById('more-panel');
  if (more && moreButton && morePanel) {
    const setOpen = (open: boolean) => {
      moreButton.setAttribute('aria-expanded', String(open));
      morePanel.hidden = !open;
    };
    moreButton.addEventListener('click', () => setOpen(moreButton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('click', (event) => {
      if (!more.contains(event.target as Node)) setOpen(false);
    });
    more.addEventListener('focusout', (event) => {
      if (!more.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !morePanel.hidden) {
        setOpen(false);
        moreButton.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    min-height: 64px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-24);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    color: var(--ink);
    text-decoration: none;
  }
  /* The logo (design/brand/; web copies made by scripts/make-brand.py) */
  .brand-logo {
    display: block;
    height: 48px;
    width: auto;
  }
  .nav-wide {
    flex: 1 1 auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-24);
    font-size: 15px;
  }
  .nav-wide a,
  .lang {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    color: var(--ink);
    text-decoration: none;
  }
  .nav-wide a:hover,
  .lang:hover {
    color: var(--accent);
  }
  .nav-wide a[aria-current='page'] {
    color: var(--accent);
  }
  .lang {
    font-size: 14px;
  }
  .calm-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    font-size: 14px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .calm-toggle input {
    width: 36px;
    height: 20px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .calm-label-on {
    display: none;
  }
  .dim-toggle,
  .menu-switch {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    font-size: 14px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .dim-toggle input,
  .menu-switch input {
    width: 36px;
    height: 20px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .menu-switch {
    min-height: 48px;
    font-size: 16px;
    color: var(--ink);
  }
  .logo-dim {
    display: none;
  }
  :global(:root[data-dim='on']) .logo-light {
    display: none;
  }
  :global(:root[data-dim='on']) .logo-dim {
    display: block;
  }
  .menu-button {
    display: none;
    width: var(--touch);
    height: var(--touch);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .menu {
    display: none;
    border-top: 1px solid var(--rule);
    padding: 0 var(--gutter) var(--s-8);
    flex-direction: column;
  }
  .menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  .menu a:last-child {
    border-bottom: 0;
  }
  /* One stronger line between the four main tools and the rest. */
  .menu .menu-more-first {
    border-top: 2px solid var(--rule);
  }
  /* "More" (desktop): a button and a small panel under it. */
  .more {
    position: relative;
    display: inline-flex;
  }
  .more-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--touch);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  .more-button:hover,
  .more-button[aria-expanded='true'] {
    color: var(--accent);
  }
  .more-button[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .more-panel {
    position: absolute;
    top: calc(100% + 4px);
    left: -16px;
    z-index: 20;
    min-width: 260px;
    padding: var(--s-12) var(--s-16);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--ink);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
  }
  .more-panel[hidden] {
    display: none;
  }
  .more-panel a {
    display: flex;
    align-items: center;
    min-height: 40px;
    color: var(--ink);
    text-decoration: none;
  }
  .more-panel a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Narrow screens: the nav moves into the menu. */
  @media (max-width: 960px) {
    .bar {
      min-height: 56px;
      gap: var(--s-4);
      flex-wrap: nowrap;
      padding-right: 8px;
    }
    .brand {
      flex: 1 1 auto;
    }
    .brand-logo {
      height: 40px;
    }
    .nav-wide,
    .nav-wide-only {
      display: none;
    }
    .menu-button {
      display: inline-flex;
    }
    .menu:not([hidden]) {
      display: flex;
    }
    /* On phones Calm mode is a small outlined button, as in the phone mockup. */
    .calm-toggle {
      padding: 0 10px;
      border: 1px solid var(--input-border);
      border-radius: var(--radius);
      color: var(--ink);
      font-size: 13px;
    }
    .calm-toggle input {
      position: absolute;
      opacity: 0;
      width: 1px;
      height: 1px;
    }
    .calm-toggle:has(input:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* Calm mode on phones (HomeCalm mockup): taller bar, filled "Calm on" button. */
    :global(:root[data-calm='on']) .bar {
      min-height: 64px;
    }
    :global(:root[data-calm='on']) .brand-logo {
      height: 46px;
    }
    :global(:root[data-calm='on']) .calm-toggle {
      padding: 0 12px;
      border: 2px solid var(--ink);
      background: var(--ink);
      color: var(--surface);
      font-size: 15px;
      font-weight: 500;
    }
    :global(:root[data-calm='on']) .calm-label-off {
      display: none;
    }
    :global(:root[data-calm='on']) .calm-label-on {
      display: inline;
    }
    :global(:root[data-calm='on']) .menu-button {
      width: 48px;
      height: 48px;
    }
  }

  /* Spanish labels are longer: tighter spacing keeps the bar on one row from 1200 px wide; below that, and with
     Calm mode's larger text, the nav moves into the menu, as it does for English below 961 px. (Walk-through 2, item 3.) */
  @media (min-width: 961px) {
    :global(:root:lang(es)) .bar {
      gap: 10px;
      flex-wrap: nowrap;
    }
    :global(:root:lang(es)) .nav-wide {
      gap: 14px;
      flex-wrap: nowrap;
    }
    :global(:root:lang(es)) .bar > * {
      white-space: nowrap;
    }
  }
  @media (min-width: 961px) and (max-width: 1199px) {
    :global(:root:lang(es)) .nav-wide,
    :global(:root:lang(es)) .nav-wide-only {
      display: none;
    }
    :global(:root:lang(es)) .brand {
      flex: 1 1 auto;
    }
    :global(:root:lang(es)) .menu-button {
      display: inline-flex;
    }
    :global(:root:lang(es)) .menu:not([hidden]) {
      display: flex;
    }
  }
  @media (min-width: 961px) and (max-width: 1599px) {
    :global(:root:lang(es)[data-calm='on']) .nav-wide,
    :global(:root:lang(es)[data-calm='on']) .nav-wide-only {
      display: none;
    }
    :global(:root:lang(es)[data-calm='on']) .brand {
      flex: 1 1 auto;
    }
    :global(:root:lang(es)[data-calm='on']) .menu-button {
      display: inline-flex;
    }
    :global(:root:lang(es)[data-calm='on']) .menu:not([hidden]) {
      display: flex;
    }
  }

  /* Calm mode: larger header text everywhere. */
  :global(:root[data-calm='on']) .nav-wide,
  :global(:root[data-calm='on']) .lang {
    font-size: 16px;
  }
  @media (min-width: 961px) {
    :global(:root[data-calm='on']) .calm-toggle {
      font-size: 16px;
    }
  }
</style>
