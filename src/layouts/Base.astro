---
/**
 * Base layout for the light pages: head, header, main, footer.
 * No third-party requests: fonts are bundled, there are no external scripts or stylesheets.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStrings } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const t = getStrings();
const { title, description = t.metaDescription, lang = 'en' } = Astro.props;
const pageTitle = title ? `${title} · ${t.siteName}` : t.siteName;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skipLink}</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
