---
/** Stand-in pages for every page that isn't built yet. Remove an entry when its real page exists. */
import NotBuilt from '../components/NotBuilt.astro';
import { getStrings } from '../i18n';

export function getStaticPaths() {
  const pages = getStrings().stub.pages;
  return Object.entries(pages).map(([page, title]) => ({ params: { page }, props: { title } }));
}

const { title } = Astro.props;
---

<NotBuilt title={title} />
