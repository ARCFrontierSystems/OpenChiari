---
/**
 * 3D Explorer. Layout from design/mockups/Explorer.dc.html (desktop) and ExplorerPhone.dc.html (phone).
 * Step 3: the workspace and controls, with the 2D anatomy figure in the view.
 * The Simple 3D model replaces the figure in step 4; camera presets, cut-away and layers
 * take effect on the model in steps 4 to 6.
 * All text from src/i18n/en.json (medical text word for word from docs/COPY.md).
 */
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import { anatomyFigureSvg, CONDITIONS } from '../lib/anatomy-figure';
import { initialState, LAYERS, SIMPLE_LAYERS, CAMERA_PRESETS } from '../explorer/state';
const RESET_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4"></path></svg>';
import { getStrings, routes } from '../i18n';

const s = getStrings();
const x = s.explorer;
const st = initialState;
const figureWide = anatomyFigureSvg({ condition: st.condition, flow: st.flow, labels: st.labels, measure: st.measure, dark: true }, s.figure);
const figureNarrow = anatomyFigureSvg({ condition: st.condition, flow: st.flow, labels: false, measure: st.measure, dark: true }, s.figure);
const part = x.parts.find((p) => p.id === st.part)!;
const cond = x.conditions[st.condition];
const linkIcon = 'M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1';
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={x.title} themeColor="#17181C" />
  </head>
  <body class="x">
    <a class="skip-link" href="#viewer">{s.skipLink}</a>

    <header class="x-header">
      <a class="x-back only-narrow-x" href={routes.home} aria-label={x.backHome}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
      </a>
      <a class="x-brand only-wide-x" href={routes.home}>
        <span class="x-mark" aria-hidden="true"></span>
        <span class="x-brand-name">{s.siteName}</span>
      </a>
      <span class="x-sep only-wide-x" aria-hidden="true">/</span>
      <h1 class="x-title">{x.title}</h1>
      <span class="x-spacer"></span>
      <a class="x-lang only-wide-x" href={routes.es} lang="es" hreflang="es">{s.header.espanol}</a>
      <label class="x-calm">
        <input type="checkbox" role="switch" data-calm-switch aria-label={s.header.calm} />
        <span class="x-calm-off" aria-hidden="true">{s.header.calm}</span>
        <span class="x-calm-on" aria-hidden="true">{s.calm.on}</span>
      </label>
      <a class="x-explain" href={routes.explain} aria-label={x.explainAria}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={linkIcon}></path></svg>
        <span class="only-wide-x">{x.explain}</span>
      </a>
    </header>

    <div class="workspace">
      <!-- Left panel on desktop; the "Layers" panel on phones. -->
      <aside class="x-left" id="view-options" aria-label={x.viewOptions}>
        <fieldset class="x-section x-cond-list only-wide-x">
          <legend class="x-h">{x.condition}</legend>
          {CONDITIONS.map((c) => (
            <label class="x-cond-row">
              <input class="visually-hidden" type="radio" name="condition-wide" value={c} checked={c === st.condition} />
              <span class="x-dot" aria-hidden="true"></span>
              {x.conditions[c].label}
            </label>
          ))}
        </fieldset>

        <section class="x-section" aria-labelledby="layers-heading">
          <h2 class="x-h" id="layers-heading">{x.layers}</h2>
          <div class="x-layers">
            {LAYERS.map((id) => (
              <>
                <input id={`layer-${id}`} type="checkbox" data-layer-on={id} checked={st.layers[id].on} disabled={!SIMPLE_LAYERS.includes(id)} />
                <label for={`layer-${id}`}>{x.layerNames[id]}</label>
                <input type="range" min="0" max="100" step="5" value={st.layers[id].opacity} data-layer-opacity={id} aria-label={x.layerNames[id] + x.opacitySuffix} disabled={!SIMPLE_LAYERS.includes(id)} />
              </>
            ))}
          </div>
        </section>

        <section class="x-section" aria-labelledby="cut-heading">
          <h2 class="x-h" id="cut-heading">{x.cutaway}</h2>
          <input class="x-cut" type="range" min="0" max="100" step="5" value={st.cut} data-cut aria-label={x.cutawayAria} />
          <div class="x-scale" aria-hidden="true"><span>{x.cutWhole}</span><span>{x.cutMidline}</span><span>{x.cutFar}</span></div>
        </section>

        <section class="x-section" aria-labelledby="model-heading">
          <h2 class="x-h" id="model-heading">{x.model}</h2>
          <div class="x-segmented" role="group" aria-labelledby="model-heading">
            <button type="button" data-model="realistic" aria-pressed="false" disabled={import.meta.env.PUBLIC_REALISTIC_PREVIEW !== '1'}>{x.realistic}</button>
            <button type="button" data-model="simple" aria-pressed="true">{x.simple}</button>
          </div>
        </section>

        <section class="x-section only-narrow-x" aria-labelledby="camera-heading" data-3d-only>
          <h2 class="x-h" id="camera-heading">{x.camera}</h2>
          <div class="x-camera x-camera-inline" role="group" aria-labelledby="camera-heading">
            {CAMERA_PRESETS.map((v) => (
            <button type="button" data-camera={v} aria-pressed={v === st.camera ? 'true' : 'false'}>{x.cameraViews[v]}</button>
          ))}
          <button type="button" class="x-camera-reset" data-camera-reset aria-label={x.resetCamera} set:html={RESET_ICON} />
          </div>
        </section>

        <button type="button" class="x-tool x-close only-narrow-x" data-layers-close>{x.close}</button>
      </aside>

      <main class="x-view" id="viewer" aria-label={x.viewerLabel}>
        <div
          class="x-3d"
          data-viewer
          role="application"
          aria-roledescription={x.viewerRole}
          aria-label={s.figure.ariaPrefix + s.figure.aria[st.condition]}
          aria-describedby="viewer-keys"
          hidden
        ></div>
        <p id="viewer-keys" class="visually-hidden">{x.keysHelp}</p>
        <p class="visually-hidden" aria-live="polite" data-view-description></p>
        <div class="x-labels only-wide-x" data-labels hidden></div>
        <div class="x-figure only-wide-x" data-figure="wide" set:html={figureWide} />
        <div class="x-figure x-figure-narrow only-narrow-x" data-figure="narrow" set:html={figureNarrow} />

        <div class="x-toolbar only-wide-x" role="group" aria-label={x.viewTools}>
          <button type="button" class="x-tool" data-toggle="flow" aria-pressed={(st.flow) ? 'true' : 'false'}>{x.flow}</button>
          <button type="button" class="x-tool" data-toggle="labels" aria-pressed={(st.labels) ? 'true' : 'false'}>{x.labels}</button>
          <button type="button" class="x-tool" data-toggle="measure" aria-pressed={(st.measure) ? 'true' : 'false'}>{x.measure}</button>
        </div>
        <div class="x-camera only-wide-x" role="group" aria-label={x.camera} data-3d-only>
          {CAMERA_PRESETS.map((v) => (
            <button type="button" data-camera={v} aria-pressed={v === st.camera ? 'true' : 'false'}>{x.cameraViews[v]}</button>
          ))}
          <button type="button" class="x-camera-reset" data-camera-reset aria-label={x.resetCamera} set:html={RESET_ICON} />
        </div>
        <div class="x-tools-narrow only-narrow-x" role="group" aria-label={x.viewTools}>
          <button type="button" class="x-tool" data-toggle="flow" aria-pressed={(st.flow) ? 'true' : 'false'}>{x.flowShort}</button>
          <button type="button" class="x-tool" data-toggle="measure" aria-pressed={(st.measure) ? 'true' : 'false'}>{x.measure}</button>
          <button type="button" class="x-tool" data-layers-toggle aria-expanded="false" aria-controls="view-options">{x.layers}</button>
        </div>

        <div class="x-footnotes only-wide-x">
          <p class="x-hint" data-3d-only>{x.hint}</p>
          <p class="x-caption">
            {x.captionIllustration} · {x.captionFlow} · <a href={routes.evidence}>{x.evidence}</a>
          </p>
        </div>
      </main>

      <aside class="x-right only-wide-x" aria-label={x.structures}>
        <div class="x-search">
          <label class="x-h" for="part-search">{x.structures}</label>
          <input id="part-search" type="search" placeholder={x.search} data-part-search autocomplete="off" />
        </div>
        <ul class="x-parts">
          {x.parts.map((p) => (
            <li data-part-conditions={p.conditions?.join(' ')} hidden={!!p.conditions && !p.conditions.includes(st.condition)}>
              <button type="button" data-part={p.id} aria-pressed={(p.id === st.part) ? 'true' : 'false'}>
                <span class="x-num">{p.num}</span>{p.name}
              </button>
            </li>
          ))}
        </ul>
        <div class="x-card" aria-live="polite">
          <p class="x-h"><span data-part-num>{part.num}</span> · {x.selected}</p>
          <h2 class="x-card-title" data-part-name>{part.name}</h2>
          <p class="x-card-text" data-part-text>{part.text}</p>
          <p class="x-card-note" data-cond-note>{cond.note}</p>
        </div>
      </aside>

      <section class="x-sheet only-narrow-x" aria-label={x.condition}>
        <fieldset class="x-cond-grid">
          <legend class="visually-hidden">{x.condition}</legend>
          {CONDITIONS.map((c) => (
            <label>
              <input class="visually-hidden" type="radio" name="condition-narrow" value={c} checked={c === st.condition} />
              {x.conditions[c].short}
            </label>
          ))}
        </fieldset>
        <div class="x-sheet-note" aria-live="polite">
          <p class="x-h" data-cond-title>{cond.label}</p>
          <p data-cond-note-short>{cond.noteShort}</p>
        </div>
        <button type="button" class="x-parts-toggle" aria-expanded="false" aria-controls="parts-narrow" data-parts-toggle>
          <span>{x.partsButton}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
        </button>
        <div id="parts-narrow" class="x-parts-narrow" hidden>
          <ul class="x-parts">
            {x.parts.map((p) => (
              <li data-part-conditions={p.conditions?.join(' ')} hidden={!!p.conditions && !p.conditions.includes(st.condition)}>
                <button type="button" data-part={p.id} aria-pressed={(p.id === st.part) ? 'true' : 'false'}>
                  <span class="x-num">{p.num}</span>{p.name}
                </button>
              </li>
            ))}
          </ul>
          <div class="x-card" aria-live="polite">
            <p class="x-h"><span data-part-num>{part.num}</span> · {x.selected}</p>
            <h2 class="x-card-title" data-part-name>{part.name}</h2>
            <p class="x-card-text" data-part-text>{part.text}</p>
          </div>
        </div>
        <p class="x-caption-narrow">
          {x.captionIllustration} · {x.captionFlow} · <a href={routes.evidence}>{x.evidence}</a>
        </p>
      </section>
    </div>

    <Footer dark />

    <script>
      import { bindCalmSwitches } from '../lib/calm';
      import { createStore, LAYERS, type ViewState } from '../explorer/state';
      import { anatomyFigureSvg, type Condition } from '../lib/anatomy-figure';
      import strings from '../i18n/en.json';

      bindCalmSwitches();

      const x = strings.explorer;
      const store = createStore();
      const $$ = <T extends Element = HTMLElement>(sel: string) => Array.from(document.querySelectorAll<T>(sel));

      // ----- Controls write to the store -----
      $$<HTMLInputElement>('input[name^="condition-"]').forEach((radio) =>
        radio.addEventListener('change', () => radio.checked && store.set({ condition: radio.value as Condition })),
      );
      $$<HTMLButtonElement>('[data-toggle]').forEach((button) =>
        button.addEventListener('click', () => {
          const key = button.dataset.toggle as 'flow' | 'labels' | 'measure';
          store.set({ [key]: !store.get()[key] });
        }),
      );
      $$<HTMLInputElement>('[data-layer-on]').forEach((box) =>
        box.addEventListener('change', () => store.setLayer(box.dataset.layerOn as (typeof LAYERS)[number], { on: box.checked })),
      );
      $$<HTMLInputElement>('[data-layer-opacity]').forEach((range) =>
        range.addEventListener('input', () => store.setLayer(range.dataset.layerOpacity as (typeof LAYERS)[number], { opacity: Number(range.value) })),
      );
      $$<HTMLInputElement>('[data-cut]').forEach((range) => range.addEventListener('input', () => store.set({ cut: Number(range.value) })));
      $$<HTMLButtonElement>('[data-model]').forEach((button) =>
        button.addEventListener('click', () => store.set({ model: button.dataset.model as ViewState['model'] })),
      );
      $$<HTMLButtonElement>('[data-part]').forEach((button) => button.addEventListener('click', () => store.set({ part: button.dataset.part! })));

      // Search the structures list
      const search = document.querySelector<HTMLInputElement>('[data-part-search]');
      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        search.closest('aside')!.querySelectorAll<HTMLLIElement>('.x-parts li').forEach((li) => {
          const elsewhere = !!li.dataset.partConditions && !li.dataset.partConditions.split(' ').includes(store.get().condition);
          li.hidden = elsewhere || (q !== '' && !li.textContent!.toLowerCase().includes(q));
        });
      });

      // Phone: Layers panel
      const panel = document.getElementById('view-options')!;
      const layersButton = document.querySelector<HTMLButtonElement>('[data-layers-toggle]')!;
      const setPanel = (open: boolean, returnFocus = false) => {
        panel.classList.toggle('is-open', open);
        layersButton.setAttribute('aria-expanded', String(open));
        if (open) panel.querySelector<HTMLElement>('input, button:not([disabled])')?.focus();
        else if (returnFocus) layersButton.focus();
      };
      layersButton.addEventListener('click', () => setPanel(!panel.classList.contains('is-open')));
      document.querySelector('[data-layers-close]')!.addEventListener('click', () => setPanel(false, true));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && panel.classList.contains('is-open')) setPanel(false, true);
      });

      // Phone: parts list
      const partsToggle = document.querySelector<HTMLButtonElement>('[data-parts-toggle]')!;
      const partsList = document.getElementById('parts-narrow')!;
      partsToggle.addEventListener('click', () => {
        const open = partsToggle.getAttribute('aria-expanded') !== 'true';
        partsToggle.setAttribute('aria-expanded', String(open));
        partsList.hidden = !open;
      });

      // ----- 3D view (falls back to the 2D figure if WebGL is missing or loading fails) -----
      const view = document.querySelector<HTMLElement>('.x-view')!;
      const viewerHost = document.querySelector<HTMLElement>('[data-viewer]')!;
      const labelsHost = document.querySelector<HTMLElement>('[data-labels]');
      const descriptionEl = document.querySelector<HTMLElement>('[data-view-description]')!;
      const LABEL_LAYERS: Record<string, (typeof LAYERS)[number]> = {
        cerebrum: 'brain', callosum: 'brain', cerebellum: 'brain', brainstem: 'brain', tonsil: 'brain', cord: 'brain',
        ventricle: 'csf', csf: 'csf', foramen: 'bone', c2: 'bone', syrinx: 'brain', removed: 'bone',
      };
      /** Text description of the current 3D view: condition, direction and cut. */
      const describe = (st: ViewState) => {
        const cut = st.cut === 50 ? 'midline' : st.cut === 0 ? 'whole' : st.cut < 50 ? 'near' : 'far';
        return `${strings.figure.ariaPrefix}${strings.figure.aria[st.condition]}. ${x.viewNames[st.camera]}. ${x.cutNames[cut]}.`;
      };
      import('../explorer/viewer3d').then(async ({ webglAvailable, createViewer, labelAnchor }) => {
        if (!webglAvailable()) return;
        viewerHost.hidden = false;
        try {
          const viewer = await createViewer(viewerHost, store, strings.figure, {
            labelsHost,
            labels: x.parts.map((p) => ({ part: p.id, num: p.num, name: p.name, layer: LABEL_LAYERS[p.id], anchor: labelAnchor(p.id, store.get().condition), conditions: p.conditions })),
            // Realistic model: preview builds only (not public until it passes the accuracy checks).
            // Phones and small screens get the lighter version.
            realisticUrl:
              import.meta.env.PUBLIC_REALISTIC_PREVIEW === '1'
                ? () => `/models/realistic/realistic-${Math.min(window.innerWidth, window.innerHeight) < 700 ? 'phone' : 'desktop'}.glb`
                : undefined,
            onRealistic: (status) => {
              $$<HTMLButtonElement>('[data-model="realistic"]').forEach((b) => b.setAttribute('aria-busy', String(status === 'loading')));
            },
            onPick: (part) => {
              store.set({ part });
              // On phones, open the parts list so the info card shows.
              if (partsToggle.offsetParent !== null && partsToggle.getAttribute('aria-expanded') !== 'true') partsToggle.click();
            },
          });
          view.classList.add('has-3d');
          document.body.classList.add('has-3d');
          $$<HTMLButtonElement>('[data-camera]').forEach((b) => b.addEventListener('click', () => store.set({ camera: b.dataset.camera as ViewState['camera'] })));
          $$<HTMLButtonElement>('[data-camera-reset]').forEach((b) => b.addEventListener('click', () => viewer.reset()));
          let spoken = '';
          let timer = 0;
          store.subscribe((st) => {
            const text = describe(st);
            viewerHost.setAttribute('aria-label', text);
            $$('[data-camera]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.camera === st.camera)));
            // Read the new view out after the visitor stops changing things.
            clearTimeout(timer);
            timer = window.setTimeout(() => {
              if (text !== spoken) descriptionEl.textContent = spoken = text;
            }, 600);
          });
        } catch (error) {
          console.warn('3D view unavailable, showing the figure instead.', error);
          viewerHost.hidden = true;
          viewerHost.replaceChildren();
        }
      });

      // ----- The store updates every view and control -----
      const figures = $$('[data-figure]');
      let lastFigure = '';
      store.subscribe((st) => {
        const key = [st.condition, st.flow, st.labels, st.measure].join();
        if (key !== lastFigure) {
          lastFigure = key;
          figures.forEach((host) => {
            const wide = host.dataset.figure === 'wide';
            host.innerHTML = anatomyFigureSvg(
              { condition: st.condition, flow: st.flow, labels: wide && st.labels, measure: st.measure, dark: true },
              strings.figure,
            );
          });
        }
        $$<HTMLInputElement>('input[name^="condition-"]').forEach((radio) => (radio.checked = radio.value === st.condition));
        $$('[data-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(st[b.dataset.toggle as 'flow' | 'labels' | 'measure'])));
        $$<HTMLInputElement>('[data-layer-on]').forEach((box) => (box.checked = st.layers[box.dataset.layerOn as (typeof LAYERS)[number]].on));
        $$<HTMLInputElement>('[data-layer-opacity]').forEach((r) => (r.value = String(st.layers[r.dataset.layerOpacity as (typeof LAYERS)[number]].opacity)));
        $$<HTMLInputElement>('[data-cut]').forEach((r) => (r.value = String(st.cut)));
        $$('[data-model]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.model === st.model)));
        $$('[data-part]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.part === st.part)));

        // Part 11 (syrinx, bone removed) only exists in its own view; elsewhere go back to the tonsil.
        const partHere = (p: (typeof x.parts)[number]) => !p.conditions || p.conditions.includes(st.condition);
        $$<HTMLLIElement>('li[data-part-conditions]').forEach((li) => (li.hidden = !li.dataset.partConditions!.split(' ').includes(st.condition)));
        if (!partHere(x.parts.find((p) => p.id === st.part)!)) {
          store.set({ part: 'tonsil' });
          return;
        }
        const part = x.parts.find((p) => p.id === st.part)!;
        const cond = x.conditions[st.condition];
        const setText = (sel: string, text: string) => $$(sel).forEach((el) => el.textContent !== text && (el.textContent = text));
        setText('[data-part-num]', part.num);
        setText('[data-part-name]', part.name);
        setText('[data-part-text]', part.text);
        setText('[data-cond-note]', cond.note);
        setText('[data-cond-title]', cond.label);
        setText('[data-cond-note-short]', cond.noteShort);
      });
    </script>
  </body>
</html>

<style>
  /* Dark Explorer workspace. Colors: the 3D Explorer tokens in DESIGN.md. */
  .x {
    --x-size: 14px;
    --x-size-small: 13px;
    --x-size-label: 12px;
    --x-size-caption: 11px;
    background: var(--x-bg);
    color: var(--x-text);
    font-size: var(--x-size);
    line-height: 1.45;
  }
  :global(:root[data-calm='on']) .x {
    --x-size: 16px;
    --x-size-small: 15px;
    --x-size-label: 14px;
    --x-size-caption: 13px;
  }
  .x :focus-visible {
    outline: 2px solid var(--x-accent);
    outline-offset: 2px;
  }
  .x a {
    color: var(--x-text);
  }

  @media (max-width: 960px) {
    .only-wide-x {
      display: none !important;
    }
  }
  @media (min-width: 961px) {
    .only-narrow-x {
      display: none !important;
    }
  }

  /* Small mono section labels (not uppercase) */
  .x-h {
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--x-size-label);
    font-weight: 500;
    color: var(--x-muted);
  }

  /* ---------- Header ---------- */
  .x-header {
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: var(--s-20);
    padding: 0 var(--s-20);
    background: var(--x-panel);
    border-bottom: 1px solid var(--x-border);
  }
  .x-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    text-decoration: none;
  }
  .x-mark {
    width: 9px;
    height: 9px;
    background: var(--x-brand-mark);
  }
  .x-brand-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 17px;
  }
  .x-sep {
    color: var(--x-faint);
  }
  .x-title {
    font-size: var(--x-size);
    font-weight: 500;
  }
  .x-spacer {
    flex: 1 1 auto;
  }
  .x-lang {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    text-decoration: none;
    font-size: var(--x-size-small);
  }
  .x-calm {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: var(--touch);
    font-size: var(--x-size-small);
    color: var(--x-text-2);
    cursor: pointer;
  }
  .x-calm input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--x-accent);
    cursor: pointer;
  }
  .x-calm-on {
    display: none;
  }
  .x-explain {
    display: inline-flex;
