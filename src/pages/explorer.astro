---
/**
 * 3D Explorer. Layout from design/mockups/Explorer.dc.html (desktop) and ExplorerPhone.dc.html (phone).
 * Step 3: the workspace and controls, with the 2D anatomy figure in the view.
 * The Simple 3D model replaces the figure in step 4; camera presets, cut-away and layers
 * take effect on the model in steps 4 to 6.
 * All text from src/i18n/en.json (medical text word for word from docs/COPY.md).
 */
import ListenButton from '../components/ListenButton.astro';
import TranslationNotice from '../components/TranslationNotice.astro';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import { anatomyFigureSvg, CONDITIONS } from '../lib/anatomy-figure';
import { initialState, LAYERS, CAMERA_PRESETS } from '../explorer/state';
const RESET_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4"></path></svg>';
import { getStrings, getRoutes, otherLanguagePath } from '../i18n';
const routes = getRoutes(Astro.currentLocale);

const s = getStrings(Astro.currentLocale);
const x = s.explorer;
const st = initialState;
const figureWide = anatomyFigureSvg({ condition: st.condition, flow: st.flow, labels: st.labels, measure: st.measure, dark: true }, s.figure);
const figureNarrow = anatomyFigureSvg({ condition: st.condition, flow: st.flow, labels: false, measure: st.measure, dark: true }, s.figure);
const part = x.parts.find((p) => p.id === st.part)!;
const cond = x.conditions[st.condition];
const linkIcon = 'M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1';
// "Evidence notes for this view": each view opens its own section of the Evidence notes page (docs/EVIDENCE.md).
const EVIDENCE_SECTION: Record<string, string> = { typical: '3d-model-shapes', chiari: '3d-model-shapes', syrinx: 'syrinx', surgery: 'after-decompression' };
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'en'}>
  <head>
    <Head title={x.title} themeColor="#17181C" />
  </head>
  <body class="x">
    <a class="skip-link" href="#viewer">{s.skipLink}</a>
    <TranslationNotice dark />

    <header class="x-header">
      <a class="x-back" href={routes.home} aria-label={x.backHome}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        <span>{x.home}</span>
      </a>
      <a class="x-brand only-wide-x" href={routes.home}>
        <img class="x-logo" src="/brand/logo-header-dark.png" alt={s.siteName} width="267" height="112" />
      </a>
      <span class="x-sep only-wide-x" aria-hidden="true">/</span>
      <h1 class="x-title">{x.title}</h1>
      <span class="x-spacer"></span>
      <a class="x-lang only-wide-x" href={otherLanguagePath(Astro.url.pathname)} lang={Astro.currentLocale === 'es' ? 'en' : 'es'} hreflang={Astro.currentLocale === 'es' ? 'en' : 'es'} data-other-lang>{s.header.espanol}</a>
      <label class="x-calm">
        <input type="checkbox" role="switch" data-calm-switch aria-label={s.header.calm} />
        <span class="x-calm-off" aria-hidden="true">{s.header.calm}</span>
        <span class="x-calm-on" aria-hidden="true">{s.calm.on}</span>
      </label>
      <a class="x-compare only-wide-x" href={routes.compare}>{s.compare.title}</a>
      <a class="x-explain" href={routes.explain} aria-label={x.explainAria}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={linkIcon}></path></svg>
        <span class="only-wide-x">{x.explain}</span>
      </a>
    </header>

    <div class="workspace">
      <!-- Left panel on desktop; the "Layers" panel on phones. -->
      <aside class="x-left" id="view-options" aria-label={x.viewOptions}>
        <fieldset class="x-section x-cond-list only-wide-x">
          <legend class="x-h">{x.condition}</legend>
          {CONDITIONS.map((c) => (
            <label class="x-cond-row">
              <input class="visually-hidden" type="radio" name="condition-wide" value={c} checked={c === st.condition} />
              <span class="x-dot" aria-hidden="true"></span>
              {x.conditions[c].label}
            </label>
          ))}
        </fieldset>

        <section class="x-section" aria-labelledby="layers-heading">
          <h2 class="x-h" id="layers-heading">{x.layers}</h2>
          <div class="x-layers">
            {LAYERS.map((id) => (
              <>
                <input id={`layer-${id}`} type="checkbox" data-layer-on={id} checked={st.layers[id].on} />
                <label for={`layer-${id}`}>{x.layerNames[id]}</label>
                <input type="range" min="0" max="100" step="5" value={st.layers[id].opacity} data-layer-opacity={id} aria-label={x.layerNames[id] + x.opacitySuffix} />
              </>
            ))}
          </div>
        </section>

        <section class="x-section" aria-labelledby="cut-heading">
          <h2 class="x-h" id="cut-heading">{x.cutaway}</h2>
          <div class="x-seg x-planes" role="group" aria-label={x.cutPlanes.label} data-3d-only>
            {(['sagittal', 'coronal', 'axial'] as const).map((pl) => (
              <button type="button" data-plane={pl} aria-pressed={pl === st.plane ? 'true' : 'false'}>{x.cutPlanes[pl]}</button>
            ))}
          </div>
          <input class="x-cut" type="range" min="0" max="100" step="5" value={st.cut} data-cut aria-label={x.cutawayAria} />
          <div class="x-scale" aria-hidden="true" data-cut-scale><span>{x.cutWhole}</span><span>{x.cutMidline}</span><span>{x.cutFar}</span></div>
          <p class="x-plane-hint" data-3d-only>{x.cutPlanes.hint}</p>
        </section>

        <section class="x-section" aria-labelledby="model-heading">
          <h2 class="x-h" id="model-heading">{x.model}</h2>
          <div class="x-segmented" role="group" aria-labelledby="model-heading">
            <button type="button" data-model="realistic" aria-pressed="false">{x.realistic}</button>
            <button type="button" data-model="simple" aria-pressed="true">{x.simple}</button>
          </div>
        </section>

        <section class="x-section only-narrow-x" aria-labelledby="camera-heading" data-3d-only>
          <h2 class="x-h" id="camera-heading">{x.camera}</h2>
          <div class="x-camera x-camera-inline" role="group" aria-labelledby="camera-heading">
            {CAMERA_PRESETS.map((v) => (
            <button type="button" data-camera={v} aria-pressed={v === st.camera ? 'true' : 'false'}>{x.cameraViews[v]}</button>
          ))}
          <button type="button" class="x-camera-reset" data-camera-reset aria-label={x.resetCamera} set:html={RESET_ICON} />
          </div>
        </section>

        <button type="button" class="x-tool x-close only-narrow-x" data-layers-close>{x.close}</button>
      </aside>

      <main class="x-view" id="viewer" aria-label={x.viewerLabel}>
        <div
          class="x-3d"
          data-viewer
          role="application"
          aria-roledescription={x.viewerRole}
          aria-label={s.figure.ariaPrefix + s.figure.aria[st.condition]}
          aria-describedby="viewer-keys"
          hidden
        ></div>
        <p id="viewer-keys" class="visually-hidden">{x.keysHelp}</p>
        <p class="visually-hidden" aria-live="polite" data-view-description></p>
        <div class="x-figure only-wide-x" data-figure="wide" set:html={figureWide} />
        <div class="x-figure x-figure-narrow only-narrow-x" data-figure="narrow" set:html={figureNarrow} />

        <div class="x-toolbar only-wide-x" role="group" aria-label={x.viewTools}>
          <button type="button" class="x-tool" data-toggle="flow" aria-pressed={(st.flow) ? 'true' : 'false'}>{x.flow}</button>
          <button type="button" class="x-tool" data-toggle="labels" aria-pressed={(st.labels) ? 'true' : 'false'}>{x.labels}</button>
          <button type="button" class="x-tool" data-toggle="measure" aria-pressed={(st.measure) ? 'true' : 'false'}>{x.measure}</button>
        </div>
        <!-- Lower bar: compare with typical in one tap, and the flow's pace (3D roadmap step 3). -->
        <div class="x-toolbar x-toolbar-low only-wide-x" role="group" aria-label={x.viewTools}>
          <button type="button" class="x-tool x-switcher" data-switcher>{x.switcher.toTypical}</button>
          <button type="button" class="x-tool" data-flow-pause aria-pressed="false" data-3d-only>{x.switcher.pause}</button>
          <button type="button" class="x-tool" data-flow-slow aria-pressed="false" data-3d-only>{x.switcher.slow}</button>
          <button type="button" class="x-tool" data-ar hidden>{x.ar}</button>
        </div>
        <div class="x-camera only-wide-x" role="group" aria-label={x.camera} data-3d-only>
          {CAMERA_PRESETS.map((v) => (
            <button type="button" data-camera={v} aria-pressed={v === st.camera ? 'true' : 'false'}>{x.cameraViews[v]}</button>
          ))}
          <button type="button" class="x-camera-reset" data-camera-reset aria-label={x.resetCamera} set:html={RESET_ICON} />
        </div>
        <!-- After the view tools, so the keyboard reaches Fluid flow, Labels, Measure and the camera first. -->
        <div class="x-labels only-wide-x" data-labels hidden></div>
        <div class="x-tools-narrow only-narrow-x" role="group" aria-label={x.viewTools}>
          <button type="button" class="x-tool" data-toggle="flow" aria-pressed={(st.flow) ? 'true' : 'false'}>{x.flowShort}</button>
          <button type="button" class="x-tool" data-toggle="measure" aria-pressed={(st.measure) ? 'true' : 'false'}>{x.measure}</button>
          <button type="button" class="x-tool" data-model-toggle aria-pressed={st.model === 'realistic' ? 'true' : 'false'} data-3d-only>{x.realistic}</button>
          <button type="button" class="x-tool" data-layers-toggle aria-expanded="false" aria-controls="view-options">{x.layers}</button>
        </div>

        <div class="x-footnotes only-wide-x">
          <p class="x-hint" data-3d-only>{x.hint}</p>
          <p class="x-caption">
            {x.captionIllustration} · {x.captionFlow} · <a href={routes.evidence + '#' + EVIDENCE_SECTION[st.condition]} data-evidence>{x.evidence}</a> · <a href={routes.mri + '#mri-view'}>{x.mriLink}</a>
          </p>
        </div>
      </main>

      <aside class="x-right only-wide-x" aria-label={x.structures}>
        <div class="x-search">
          <label class="x-h" for="part-search">{x.structures}</label>
          <input id="part-search" type="search" placeholder={x.search} data-part-search autocomplete="off" />
        </div>
        <ul class="x-parts">
          {x.parts.map((p) => (
            <li data-part-conditions={p.conditions?.join(' ')} hidden={!!p.conditions && !p.conditions.includes(st.condition)}>
              <button type="button" data-part={p.id} aria-pressed={(p.id === st.part) ? 'true' : 'false'}>
                <span class="x-num">{p.num}</span>{p.name}
              </button>
            </li>
          ))}
        </ul>
        <div class="x-card x-card-wide" aria-live="polite">
          <ListenButton target=".x-card-wide" dark />
          <p class="x-h"><span data-part-num>{part.num}</span> · {x.selected}</p>
          <h2 class="x-card-title" data-part-name>{part.name}</h2>
          <p class="x-card-text" data-part-text>{part.text}</p>
          <div class="x-part-actions" role="group" aria-label={x.partActions.partTools}>
            <button type="button" class="x-tool" data-part-zoom data-3d-only>{x.partActions.zoom}</button>
            <button type="button" class="x-tool" data-focus="only" aria-pressed={st.focus === 'only' ? 'true' : 'false'} data-3d-only>{x.partActions.only}</button>
            <button type="button" class="x-tool" data-focus="hide" aria-pressed={st.focus === 'hide' ? 'true' : 'false'} data-3d-only>{x.partActions.hide}</button>
            <button type="button" class="x-tool" data-focus="all" hidden={st.focus === 'all'} data-3d-only>{x.partActions.all}</button>
          </div>
          <p class="x-card-note" data-cond-note>{cond.note}</p>
          <p class="x-size-note" data-size-note hidden={!(['chiari', 'syrinx'].includes(st.condition) && st.measure)}>{x.sizeNote}</p>
        </div>
<details class="x-cough x-accuracy" data-accuracy>
          <summary>{x.accuracy.title}</summary>
          <p>{x.accuracy.intro}</p>
          <dl class="x-accuracy-list" data-accuracy-rows>
            {x.accuracy.rows[st.condition].map((r) => (
              <div class="x-acc-row">
                <dt>{r.feature}</dt>
                <dd><span class="x-acc-key">{x.accuracy.model}:</span> {r.model}</dd>
                <dd><span class="x-acc-key">{x.accuracy.published}:</span> {r.published}</dd>
              </div>
            ))}
          </dl>
          <a href={routes.evidence + '#3d-model-shapes'} data-evidence>{x.accuracy.more}</a>
        </details>
        <details class="x-cough x-cough-wide" data-cough-panel hidden={!['typical', 'chiari'].includes(st.condition)}>
          <summary>{x.cough.title}</summary>
          {x.cough.text.map((line) => <p>{line}</p>)}
          <button type="button" class="x-tool" data-cough>{x.cough.button}</button>
          <p class="x-cough-caption">{x.cough.caption} {x.captionIllustration} · {x.captionFlow}</p>
          <p class="visually-hidden" aria-live="polite" data-cough-status></p>
        </details>
        <details class="x-cough x-surgery" data-surgery-panel hidden>
          <summary>{x.surgery.title}</summary>
          <p>{x.surgery.intro}</p>
          <div class="x-surgery-controls">
            <button type="button" class="x-tool" data-surgery-play>{x.surgery.play}</button>
            <button type="button" class="x-tool" data-surgery-back disabled>{x.surgery.back}</button>
            <button type="button" class="x-tool" data-surgery-next>{x.surgery.next}</button>
          </div>
          <div class="x-surgery-step" aria-live="polite">
            <p class="x-h" data-surgery-label></p>
            <p data-surgery-text></p>
          </div>
          <button type="button" class="x-tool" data-surgery-stop hidden>{x.surgery.stop}</button>
          <p class="x-cough-caption">{x.surgery.caption} {x.captionIllustration} · {x.captionTonsils}</p>
        </details>
      </aside>

      <section class="x-sheet only-narrow-x" aria-label={x.condition}>
        <fieldset class="x-cond-grid">
          <legend class="visually-hidden">{x.condition}</legend>
          {CONDITIONS.map((c) => (
            <label>
              <input class="visually-hidden" type="radio" name="condition-narrow" value={c} checked={c === st.condition} />
              {x.conditions[c].short}
            </label>
          ))}
        </fieldset>
        <div class="x-sheet-note" aria-live="polite">
          <ListenButton target=".x-sheet-note" dark />
          <p class="x-h" data-cond-title>{cond.label}</p>
          <p data-cond-note-short>{cond.noteShort}</p>
          <p class="x-size-note" data-size-note hidden={!(['chiari', 'syrinx'].includes(st.condition) && st.measure)}>{x.sizeNote}</p>
        </div>
        <button type="button" class="x-tool x-ar-narrow" data-ar hidden>{x.ar}</button>
<details class="x-cough x-accuracy" data-accuracy>
          <summary>{x.accuracy.title}</summary>
          <p>{x.accuracy.intro}</p>
          <dl class="x-accuracy-list" data-accuracy-rows>
            {x.accuracy.rows[st.condition].map((r) => (
              <div class="x-acc-row">
                <dt>{r.feature}</dt>
                <dd><span class="x-acc-key">{x.accuracy.model}:</span> {r.model}</dd>
                <dd><span class="x-acc-key">{x.accuracy.published}:</span> {r.published}</dd>
              </div>
            ))}
          </dl>
          <a href={routes.evidence + '#3d-model-shapes'} data-evidence>{x.accuracy.more}</a>
        </details>
        <details class="x-cough x-cough-narrow" data-cough-panel hidden={!['typical', 'chiari'].includes(st.condition)}>
          <summary>{x.cough.title}</summary>
          {x.cough.text.map((line) => <p>{line}</p>)}
          <button type="button" class="x-tool" data-cough>{x.cough.button}</button>
          <p class="x-cough-caption">{x.cough.caption} {x.captionIllustration} · {x.captionFlow}</p>
          <p class="visually-hidden" aria-live="polite" data-cough-status></p>
        </details>
        <details class="x-cough x-surgery" data-surgery-panel hidden>
          <summary>{x.surgery.title}</summary>
          <p>{x.surgery.intro}</p>
          <div class="x-surgery-controls">
            <button type="button" class="x-tool" data-surgery-play>{x.surgery.play}</button>
            <button type="button" class="x-tool" data-surgery-back disabled>{x.surgery.back}</button>
            <button type="button" class="x-tool" data-surgery-next>{x.surgery.next}</button>
          </div>
          <div class="x-surgery-step" aria-live="polite">
            <p class="x-h" data-surgery-label></p>
            <p data-surgery-text></p>
          </div>
          <button type="button" class="x-tool" data-surgery-stop hidden>{x.surgery.stop}</button>
          <p class="x-cough-caption">{x.surgery.caption} {x.captionIllustration} · {x.captionTonsils}</p>
        </details>
        <button type="button" class="x-parts-toggle" aria-expanded="false" aria-controls="parts-narrow" data-parts-toggle>
          <span>{x.partsButton}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
        </button>
        <div id="parts-narrow" class="x-parts-narrow" hidden>
          <div class="x-card" aria-live="polite" data-card-narrow>
            <p class="x-h"><span data-part-num>{part.num}</span> · {x.selected}</p>
            <h2 class="x-card-title" data-part-name>{part.name}</h2>
            <p class="x-card-text" data-part-text>{part.text}</p>
            <div class="x-part-actions" role="group" aria-label={x.partActions.partTools}>
              <button type="button" class="x-tool" data-part-zoom data-3d-only>{x.partActions.zoom}</button>
              <button type="button" class="x-tool" data-focus="only" aria-pressed={st.focus === 'only' ? 'true' : 'false'} data-3d-only>{x.partActions.only}</button>
              <button type="button" class="x-tool" data-focus="hide" aria-pressed={st.focus === 'hide' ? 'true' : 'false'} data-3d-only>{x.partActions.hide}</button>
              <button type="button" class="x-tool" data-focus="all" hidden={st.focus === 'all'} data-3d-only>{x.partActions.all}</button>
            </div>
          </div>
          <ul class="x-parts">
            {x.parts.map((p) => (
              <li data-part-conditions={p.conditions?.join(' ')} hidden={!!p.conditions && !p.conditions.includes(st.condition)}>
                <button type="button" data-part={p.id} aria-pressed={(p.id === st.part) ? 'true' : 'false'}>
                  <span class="x-num">{p.num}</span>{p.name}
                </button>
              </li>
            ))}
          </ul>
        </div>
        <p class="x-caption-narrow">
          {x.captionIllustration} · {x.captionFlow} · <a href={routes.evidence + '#' + EVIDENCE_SECTION[st.condition]} data-evidence>{x.evidence}</a>
        </p>
      </section>
    </div>

    <Footer dark />

    <script>
      import { bindCalmSwitches, isCalm, onCalmChange } from '../lib/calm';
      import { createStore, LAYERS, type ViewState } from '../explorer/state';
      import { decodeView, encodeView, type Orbit } from '../explorer/share';
      import { count } from '../lib/count';
      import { anatomyFigureSvg, type Condition } from '../lib/anatomy-figure';
      import strings from '../i18n/client';

      bindCalmSwitches();

      const x = strings.explorer;
      const EVIDENCE_SECTION: Record<string, string> = { typical: '3d-model-shapes', chiari: '3d-model-shapes', syrinx: 'syrinx', surgery: 'after-decompression' };
      // A view passed in the link after the # (from Explain It) opens here as it was; nothing is sent anywhere.
      const shared = decodeView(location.hash);
      const store = createStore(shared?.state);
      const $$ = <T extends Element = HTMLElement>(sel: string) => Array.from(document.querySelectorAll<T>(sel));

      // ----- Controls write to the store -----
      $$<HTMLInputElement>('input[name^="condition-"]').forEach((radio) =>
        radio.addEventListener('change', () => radio.checked && store.set({ condition: radio.value as Condition })),
      );
      // Typical <-> the condition you were looking at, in one tap (the model fades between them).
      let lastNotTypical: Condition = store.get().condition === 'typical' ? 'chiari' : store.get().condition;
      $$<HTMLButtonElement>('[data-switcher]').forEach((button) =>
        button.addEventListener('click', () => store.set({ condition: store.get().condition === 'typical' ? lastNotTypical : 'typical' })),
      );
      store.subscribe((st) => {
        if (st.condition !== 'typical') lastNotTypical = st.condition;
        // "Show Chiari I", "Show Chiari I with syrinx", "Show after surgery": the full name, lower-cased unless it starts with Chiari.
        const full = x.conditions[lastNotTypical].label;
        const name = full.startsWith('Chiari') ? full : full.charAt(0).toLowerCase() + full.slice(1);
        const label = st.condition === 'typical' ? x.switcher.toCondition.replace('{name}', name) : x.switcher.toTypical;
        $$<HTMLButtonElement>('[data-switcher]').forEach((b) => b.textContent !== label && (b.textContent = label));
        // Pause and Slow only mean something while the flow shows.
        $$<HTMLButtonElement>('[data-flow-pause], [data-flow-slow]').forEach((b) => (b.hidden = !st.flow));
      });
      // Accuracy panel: the rows for the condition on show.
      store.subscribe((st) => {
        $$<HTMLElement>('[data-accuracy-rows]').forEach((body) => {
          if (body.dataset.condition === st.condition) return;
          body.dataset.condition = st.condition;
          body.replaceChildren(
            ...x.accuracy.rows[st.condition].map((r) => {
              const row = Object.assign(document.createElement('div'), { className: 'x-acc-row' });
              const dd = (key: string, text: string) => {
                const el = document.createElement('dd');
                el.append(Object.assign(document.createElement('span'), { className: 'x-acc-key', textContent: key + ':' }), ' ' + text);
                return el;
              };
              row.append(Object.assign(document.createElement('dt'), { textContent: r.feature }), dd(x.accuracy.model, r.model), dd(x.accuracy.published, r.published));
              return row;
            }),
          );
        });
      });
      // Show only / hide the selected part, and show everything again.
      $$<HTMLButtonElement>('[data-focus]').forEach((button) =>
        button.addEventListener('click', () => {
          const want = button.dataset.focus as ViewState['focus'];
          store.set({ focus: store.get().focus === want ? 'all' : want });
        }),
      );
      store.subscribe((st) => {
        $$<HTMLButtonElement>('[data-focus="only"], [data-focus="hide"]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.focus === st.focus)));
        $$<HTMLButtonElement>('[data-focus="all"]').forEach((b) => (b.hidden = st.focus === 'all'));
      });
      $$<HTMLButtonElement>('[data-toggle]').forEach((button) =>
        button.addEventListener('click', () => {
          const key = button.dataset.toggle as 'flow' | 'labels' | 'measure';
          store.set({ [key]: !store.get()[key] });
        }),
      );
      $$<HTMLInputElement>('[data-layer-on]').forEach((box) =>
        box.addEventListener('change', () => store.setLayer(box.dataset.layerOn as (typeof LAYERS)[number], { on: box.checked })),
      );
      $$<HTMLInputElement>('[data-layer-opacity]').forEach((range) =>
        range.addEventListener('input', () => store.setLayer(range.dataset.layerOpacity as (typeof LAYERS)[number], { opacity: Number(range.value) })),
      );
      $$<HTMLInputElement>('[data-cut]').forEach((range) => range.addEventListener('input', () => store.set({ cut: Number(range.value) })));
      // Cut direction: side keeps the side view; front looks from behind; across looks from below (as MRI shows it).
      // The cut starts through the skull opening (or at the midline for the side cut).
      const PLANE_CAMERA = { sagittal: 'side', coronal: 'back', axial: 'below' } as const;
      $$<HTMLButtonElement>('[data-plane]').forEach((button) =>
        button.addEventListener('click', () => {
          const plane = button.dataset.plane as ViewState['plane'];
          if (plane === store.get().plane) return;
          // The flow and the measure live on the midline, so they step aside for the other two directions.
          // Front and across cuts use the realistic model: the Simple model is drawn from side-view outlines, so cut
          // any other way it would show shapes that aren't anatomy.
          store.set({ plane, cut: 50, camera: PLANE_CAMERA[plane], ...(plane === 'sagittal' ? {} : { flow: false, measure: false, labels: false, model: 'realistic' }) });
        }),
      );
      store.subscribe((st) => {
        // Back to the Simple model means back to the side cut (see above).
        if (st.model === 'simple' && st.plane !== 'sagittal') {
          store.set({ plane: 'sagittal', cut: 50, camera: 'side' });
          return;
        }
        $$<HTMLButtonElement>('[data-plane]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.plane === st.plane)));
        const ends = st.plane === 'sagittal' ? [x.cutWhole, x.cutMidline, x.cutFar] : x.cutPlanes.ends[st.plane];
        $$<HTMLElement>('[data-cut-scale]').forEach((scale) => scale.querySelectorAll('span').forEach((s, i) => s.textContent !== ends[i] && (s.textContent = ends[i])));
      });
      // Phones: the Realistic switch sits with the other view tools, so it's easy to find.
      $$<HTMLButtonElement>('[data-model-toggle]').forEach((button) =>
        button.addEventListener('click', () => store.set({ model: store.get().model === 'realistic' ? 'simple' : 'realistic' })),
      );
      $$<HTMLButtonElement>('[data-model]').forEach((button) =>
        button.addEventListener('click', () => store.set({ model: button.dataset.model as ViewState['model'] })),
      );
      $$<HTMLButtonElement>('[data-part]').forEach((button) =>
        button.addEventListener('click', () => {
          store.set({ part: button.dataset.part! });
          // Phones: bring the part's description into view (it sits above the list).
          if (button.closest('#parts-narrow')) document.querySelector('[data-card-narrow]')?.scrollIntoView({ block: 'nearest' });
        }),
      );

      // Search the structures list
      const search = document.querySelector<HTMLInputElement>('[data-part-search]');
      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        search.closest('aside')!.querySelectorAll<HTMLLIElement>('.x-parts li').forEach((li) => {
          const elsewhere = !!li.dataset.partConditions && !li.dataset.partConditions.split(' ').includes(store.get().condition);
          li.hidden = elsewhere || (q !== '' && !li.textContent!.toLowerCase().includes(q));
        });
      });

      // Phone: Layers panel
      const panel = document.getElementById('view-options')!;
      const layersButton = document.querySelector<HTMLButtonElement>('[data-layers-toggle]')!;
      const setPanel = (open: boolean, returnFocus = false) => {
        panel.classList.toggle('is-open', open);
        layersButton.setAttribute('aria-expanded', String(open));
        if (open) panel.querySelector<HTMLElement>('input, button:not([disabled])')?.focus();
        else if (returnFocus) layersButton.focus();
      };
      layersButton.addEventListener('click', () => setPanel(!panel.classList.contains('is-open')));
      document.querySelector('[data-layers-close]')!.addEventListener('click', () => setPanel(false, true));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && panel.classList.contains('is-open')) setPanel(false, true);
      });

      // Phone: parts list
      const partsToggle = document.querySelector<HTMLButtonElement>('[data-parts-toggle]')!;
      const partsList = document.getElementById('parts-narrow')!;
      partsToggle.addEventListener('click', () => {
        const open = partsToggle.getAttribute('aria-expanded') !== 'true';
        partsToggle.setAttribute('aria-expanded', String(open));
        partsList.hidden = !open;
      });

      // ----- 3D view (falls back to the 2D figure if WebGL is missing or loading fails) -----
      const view = document.querySelector<HTMLElement>('.x-view')!;
      const viewerHost = document.querySelector<HTMLElement>('[data-viewer]')!;
      const labelsHost = document.querySelector<HTMLElement>('[data-labels]');
      const descriptionEl = document.querySelector<HTMLElement>('[data-view-description]')!;
      const LABEL_LAYERS: Record<string, (typeof LAYERS)[number]> = {
        cerebrum: 'brain', callosum: 'brain', cerebellum: 'brain', brainstem: 'brain', tonsil: 'brain', cord: 'brain',
        ventricle: 'csf', csf: 'csf', foramen: 'bone', c2: 'bone', syrinx: 'brain', removed: 'bone',
      };
      /** Text description of the current 3D view: condition, direction and cut. */
      // Part way through "What happens in surgery", the view is described by its step, not as the finished operation.
      let stageDescription = '';
      const describe = (st: ViewState) => {
        if (stageDescription && st.condition === 'surgery') return `${strings.figure.ariaPrefix}${stageDescription}`;
        const cut = st.cut === 50 ? 'midline' : st.cut === 0 ? 'whole' : st.cut < 50 ? 'near' : 'far';
        const cutText = st.plane === 'sagittal' ? x.cutNames[cut] : x.cutPlanes.describe[st.plane];
        return `${strings.figure.ariaPrefix}${strings.figure.aria[st.condition]}. ${x.viewNames[st.camera]}. ${cutText}.`;
      };
      import('../explorer/viewer3d').then(async ({ webglAvailable, createViewer, labelAnchor }) => {
        if (!webglAvailable()) return;
        viewerHost.hidden = false;
        try {
          const viewer = await createViewer(viewerHost, store, strings.figure, {
            labelsHost,
            labels: x.parts.map((p) => ({ part: p.id, num: p.num, name: p.name, layer: LABEL_LAYERS[p.id], anchor: labelAnchor(p.id, store.get().condition), conditions: p.conditions })),
            // Realistic model: loaded only when picked; phones and small screens get the lighter version.
            realisticUrl: () => `/models/realistic/realistic-${Math.min(window.innerWidth, window.innerHeight) < 700 ? 'phone' : 'desktop'}.glb`,
            startOrbit: shared?.orbit ?? null,
            onRealistic: (status) => {
              $$<HTMLButtonElement>('[data-model="realistic"], [data-model-toggle]').forEach((b) => b.setAttribute('aria-busy', String(status === 'loading')));
            },
            onPick: (part) => {
              store.set({ part });
              // On phones, open the parts list so the info card shows.
              if (partsToggle.offsetParent !== null && partsToggle.getAttribute('aria-expanded') !== 'true') partsToggle.click();
            },
          });
          view.classList.add('has-3d');
          document.body.classList.add('has-3d');
          count('explore');
          // Why can coughing bring on a headache? One press: the fluid marks move up into the head and ease back.
          document.querySelectorAll<HTMLButtonElement>('[data-cough]').forEach((button) =>
            button.addEventListener('click', async () => {
              const status = button.closest('[data-cough-panel]')!.querySelector<HTMLElement>('[data-cough-status]')!;
              const v = (viewerHost as HTMLElement & { viewer?: { cough(cb: (phase: string) => void): Promise<void> } }).viewer;
              if (!v) return;
              button.disabled = true;
              await v.cough((phase) => {
                if (phase === 'up') status.textContent = x.cough.up;
                if (phase === 'back') status.textContent = x.cough.back;
              });
              button.disabled = false;
            }),
          );
          // What happens in surgery, step by step: the After decompression view drawn part way through. Play moves on by
          // itself; in Calm mode (or with reduced motion) nothing moves on its own: Next and Back only.
          {
            const sv = viewerHost as HTMLElement & { viewer?: { setSurgeryStage(stage: number | null): void } };
            const steps = x.surgery.steps;
            const panels = () => Array.from(document.querySelectorAll<HTMLElement>('[data-surgery-panel]'));
            const playButtons = () => Array.from(document.querySelectorAll<HTMLButtonElement>('[data-surgery-play]'));
            let step: number | null = null;
            let timer = 0;
            const STEP_MS = 7000;
            const pauseTimer = () => {
              clearInterval(timer);
              timer = 0;
              playButtons().forEach((b) => (b.textContent = x.surgery.play));
            };
            const render = () => {
              panels().forEach((panel) => {
                const label = panel.querySelector<HTMLElement>('[data-surgery-label]')!;
                const text = panel.querySelector<HTMLElement>('[data-surgery-text]')!;
                label.textContent = step === null ? '' : `${x.surgery.stepLabel.replace('{n}', String(step + 1)).replace('{total}', String(steps.length))} · ${steps[step].title}`;
                text.textContent = step === null ? '' : steps[step].text;
                panel.querySelector<HTMLButtonElement>('[data-surgery-back]')!.disabled = step === null || step === 0;
                panel.querySelector<HTMLButtonElement>('[data-surgery-next]')!.disabled = step === steps.length - 1;
                panel.querySelector<HTMLButtonElement>('[data-surgery-stop]')!.hidden = step === null;
              });
              // "11 Bone removed" joins the parts list once the bone is out.
              document.querySelectorAll<HTMLElement>('[data-part="removed"]').forEach((el) => {
                const li = el.closest('li');
                if (li) li.hidden = store.get().condition !== 'surgery' || (step !== null && step < 2);
              });
            };
            const show = (n: number) => {
              stageDescription = `${steps[n].title}. ${steps[n].text}`;
              if (store.get().condition !== 'surgery') store.set({ condition: 'surgery' });
              step = n;
              sv.viewer?.setSurgeryStage(n);
              viewerHost.setAttribute('aria-label', describe(store.get()));
              render();
              if (n === steps.length - 1) pauseTimer();
            };
            const stop = () => {
              pauseTimer();
              step = null;
              stageDescription = '';
              sv.viewer?.setSurgeryStage(null);
              viewerHost.setAttribute('aria-label', describe(store.get()));
              render();
            };
            playButtons().forEach((b) =>
              b.addEventListener('click', () => {
                if (timer) return pauseTimer();
                show(step === null || step === steps.length - 1 ? 0 : step);
                if (isCalm()) return;
                playButtons().forEach((pb) => (pb.textContent = x.surgery.pause));
                timer = window.setInterval(() => show(Math.min((step ?? 0) + 1, steps.length - 1)), STEP_MS);
              }),
            );
            document.querySelectorAll<HTMLButtonElement>('[data-surgery-next]').forEach((b) =>
              b.addEventListener('click', () => {
                pauseTimer();
                show(step === null ? 0 : Math.min(step + 1, steps.length - 1));
              }),
            );
            document.querySelectorAll<HTMLButtonElement>('[data-surgery-back]').forEach((b) =>
              b.addEventListener('click', () => {
                pauseTimer();
                show(Math.max((step ?? 1) - 1, 0));
              }),
            );
            document.querySelectorAll<HTMLButtonElement>('[data-surgery-stop]').forEach((b) => b.addEventListener('click', stop));
            onCalmChange(() => {
              if (isCalm()) pauseTimer();
            });
            // Leaving the After decompression view ends the play-through. The panel shows with Chiari I and after surgery.
            const placePanels = (condition: string) => panels().forEach((el) => (el.hidden = !['chiari', 'surgery'].includes(condition)));
            store.subscribe((st) => {
              if (st.condition !== 'surgery' && step !== null) stop();
              placePanels(st.condition);
              // Other controls redraw the parts list; keep "11 Bone removed" in step with the play-through.
              queueMicrotask(render);
            });
            placePanels(store.get().condition);
            render();
          }
          // "See it in your room": only where the phone or tablet can show it (src/explorer/ar.ts).
          import('../explorer/ar').then(async ({ arSupport, openAr }) => {
            const kind = await arSupport();
            if (!kind) return;
            const host = viewerHost as HTMLElement & { viewer?: { arModel(): Promise<import('three').Group> } };
            document.querySelectorAll<HTMLButtonElement>('[data-ar]').forEach((button) => {
              button.hidden = false;
              button.addEventListener('click', async () => {
                if (!host.viewer) return;
                button.disabled = true;
                try {
                  const st = store.get();
                  const caption = [x.captionIllustration, x.captionTonsils].join('. ') + '.';
                  const f = strings.footer;
                  await openAr(kind, await host.viewer.arModel(), {
                    title: x.conditions[st.condition].label, caption, hint: x.arHint, close: x.close,
                    advice: `${f.notAdvice} ${f.notAdviceRest.wide}`,
                    credit: `${f.modelBefore.replace(/^\.\s*/, '')} ${f.zAnatomy} ${f.modelAfter}`,
                  });
                } catch (error) {
                  console.warn('Room view not available.', error);
                } finally {
                  button.disabled = false;
                }
              });
            });
          });
          $$<HTMLButtonElement>('[data-camera]').forEach((b) => b.addEventListener('click', () => store.set({ camera: b.dataset.camera as ViewState['camera'] })));
          $$<HTMLButtonElement>('[data-camera-reset]').forEach((b) => b.addEventListener('click', () => viewer.reset()));
          $$<HTMLButtonElement>('[data-part-zoom]').forEach((b) => b.addEventListener('click', () => viewer.focusPart(store.get().part)));
          // Flow: pause keeps the marks where they are; slow runs them at 40%.
          const pause = $$<HTMLButtonElement>('[data-flow-pause]');
          const slow = $$<HTMLButtonElement>('[data-flow-slow]');
          const flowSpeed = () => {
            const paused = pause[0]?.getAttribute('aria-pressed') === 'true';
            const slowed = slow[0]?.getAttribute('aria-pressed') === 'true';
            viewer.setFlowSpeed(paused ? 0 : slowed ? 0.4 : 1);
          };
          [...pause, ...slow].forEach((b) =>
            b.addEventListener('click', () => {
              b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
              flowSpeed();
            }),
          );
          let spoken = '';
          let timer = 0;
          store.subscribe((st) => {
            const text = describe(st);
            viewerHost.setAttribute('aria-label', text);
            $$('[data-camera]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.camera === st.camera)));
            // Read the new view out after the visitor stops changing things.
            clearTimeout(timer);
            timer = window.setTimeout(() => {
              if (text !== spoken) descriptionEl.textContent = spoken = text;
            }, 600);
          });
        } catch (error) {
          console.warn('3D view unavailable, showing the figure instead.', error);
          viewerHost.hidden = true;
          viewerHost.replaceChildren();
        }
      });

      // ----- Explain It: the button carries this view (and a hand-turned camera) to the page that makes the link -----
      document.querySelectorAll<HTMLAnchorElement>('a.x-explain').forEach((a) =>
        a.addEventListener('click', () => {
          const st = store.get();
          const v = (document.querySelector('[data-viewer]') as (HTMLElement & { viewer?: { orbit(): Orbit } }) | null)?.viewer;
          a.href = `/explain/#${encodeView({ state: st, orbit: st.camera === 'custom' ? v?.orbit() ?? null : null, explore: true })}`;
        }),
      );

      // ----- The store updates every view and control -----
      const figures = $$('[data-figure]');
      let lastFigure = '';
      store.subscribe((st) => {
        const key = [st.condition, st.flow, st.labels, st.measure].join();
        if (key !== lastFigure) {
          lastFigure = key;
          figures.forEach((host) => {
            const wide = host.dataset.figure === 'wide';
            host.innerHTML = anatomyFigureSvg(
              { condition: st.condition, flow: st.flow, labels: wide && st.labels, measure: st.measure, dark: true },
              strings.figure,
            );
          });
        }
        $$<HTMLInputElement>('input[name^="condition-"]').forEach((radio) => (radio.checked = radio.value === st.condition));
        $$('[data-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(st[b.dataset.toggle as 'flow' | 'labels' | 'measure'])));
        $$<HTMLInputElement>('[data-layer-on]').forEach((box) => (box.checked = st.layers[box.dataset.layerOn as (typeof LAYERS)[number]].on));
        $$<HTMLInputElement>('[data-layer-opacity]').forEach((r) => (r.value = String(st.layers[r.dataset.layerOpacity as (typeof LAYERS)[number]].opacity)));
        $$<HTMLInputElement>('[data-cut]').forEach((r) => (r.value = String(st.cut)));
        $$('[data-model]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.model === st.model)));
        $$('[data-model-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(st.model === 'realistic')));
        $$<HTMLAnchorElement>('[data-evidence]').forEach((link) => (link.hash = EVIDENCE_SECTION[st.condition]));
        $$('[data-part]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.part === st.part)));

        // Part 11 (syrinx, bone removed) only exists in its own view; elsewhere go back to the tonsil.
        const partHere = (p: (typeof x.parts)[number]) => !p.conditions || p.conditions.includes(st.condition);
        $$<HTMLLIElement>('li[data-part-conditions]').forEach((li) => (li.hidden = !li.dataset.partConditions!.split(' ').includes(st.condition)));
        if (!partHere(x.parts.find((p) => p.id === st.part)!)) {
          store.set({ part: 'tonsil' });
          return;
        }
        const part = x.parts.find((p) => p.id === st.part)!;
        const cond = x.conditions[st.condition];
        const setText = (sel: string, text: string) => $$(sel).forEach((el) => el.textContent !== text && (el.textContent = text));
        setText('[data-part-num]', part.num);
        setText('[data-part-name]', part.name);
        setText('[data-part-text]', part.text);
        setText('[data-cond-note]', cond.note);
        setText('[data-cond-title]', cond.label);
        setText('[data-cond-note-short]', cond.noteShort);
        // The size line goes with the 12 mm views and their measure bracket; the cough panel with Typical and Chiari I.
        $$('[data-size-note]').forEach((el) => (el.hidden = !(['chiari', 'syrinx'].includes(st.condition) && st.measure)));
        $$('[data-cough-panel]').forEach((el) => (el.hidden = !['typical', 'chiari'].includes(st.condition)));
      });
    </script>
  </body>
</html>

<style>
  /* Dark Explorer workspace. Colors: the 3D Explorer tokens in DESIGN.md. */
  .x {
    --x-size: 14px;
    --x-size-small: 13px;
    --x-size-label: 12px;
    --x-size-caption: 11px;
    background: var(--x-bg);
    color: var(--x-text);
    font-size: var(--x-size);
    line-height: 1.45;
  }
  :global(:root[data-calm='on']) .x {
    --x-size: 16px;
    --x-size-small: 15px;
    --x-size-label: 14px;
    --x-size-caption: 13px;
  }
  .x :focus-visible {
    outline: 2px solid var(--x-accent);
    outline-offset: 2px;
  }
  .x a {
    color: var(--x-text);
  }

  @media (max-width: 960px) {
    .only-wide-x {
      display: none !important;
    }
  }
  @media (min-width: 961px) {
    .only-narrow-x {
      display: none !important;
    }
  }

  /* Small mono section labels (not uppercase) */
  .x-h {
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--x-size-label);
    font-weight: 500;
    color: var(--x-muted);
  }

  /* ---------- Header ---------- */
  .x-header {
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: var(--s-20);
    padding: 0 var(--s-20);
    background: var(--x-panel);
    border-bottom: 1px solid var(--x-border);
  }
  .x-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    text-decoration: none;
  }
  .x-logo {
    display: block;
    height: 34px;
    width: auto;
  }
  .x-sep {
    color: var(--x-faint);
  }
  .x-title {
    font-size: var(--x-size);
    font-weight: 500;
  }
  .x-spacer {
    flex: 1 1 auto;
  }
  .x-lang {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    text-decoration: none;
    font-size: var(--x-size-small);
  }
  .x-calm {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: var(--touch);
    font-size: var(--x-size-small);
    color: var(--x-text-2);
    cursor: pointer;
  }
  .x-calm input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--x-accent);
    cursor: pointer;
  }
  .x-calm-on {
    display: none;
  }
  .x-compare {
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    color: var(--x-text);
    text-decoration: none;
    border: 1px solid var(--x-control-border);
    border-radius: var(--radius);
  }
  .x-explain {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--touch);
    padding: 0 14px;
    border-radius: var(--radius);
    background: var(--x-button-bg);
    font-weight: 500;
    text-decoration: none;
  }
  .x .x-explain {
    color: var(--x-button-text);
  }
  /* "Home", always visible at the top left (Matthew, Nov 5): outlined like the other header buttons. */
  .x-back {
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 12px 0 8px;
    color: var(--x-text);
    text-decoration: none;
    border: 1px solid var(--x-control-border);
    border-radius: var(--radius);
    font-size: var(--x-size-small);
  }

  /* ---------- Workspace ---------- */
  .workspace {
    display: grid;
    grid-template-columns: 272px minmax(0, 1fr) 320px;
    height: calc(100vh - 53px);
    /* svh: the screen height with the address bar showing. Unlike dvh it doesn't change while a phone scrolls,
       so the 3D view isn't resized and redrawn on every scroll step. */
    height: calc(100svh - 53px);
    min-height: 600px;
  }
  .x-left {
    background: var(--x-panel);
    border-right: 1px solid var(--x-border);
    padding: var(--s-20);
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
    overflow-y: auto;
  }
  .x-section {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
    min-width: 0;
  }
  .x-section > legend {
    margin-bottom: var(--s-8);
  }

  /* Condition list (desktop) */
  .x-cond-list {
    gap: 0;
  }
  .x-cond-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    padding: 0 12px;
    border: 1px solid var(--x-border);
    cursor: pointer;
  }
  .x-cond-row + .x-cond-row {
    border-top: 0;
  }
  .x-cond-row:first-of-type {
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .x-cond-row:last-of-type {
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .x-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
    border: 1.5px solid var(--x-muted);
  }
  .x-cond-row:has(input:checked) {
    background: var(--x-border);
    font-weight: 600;
  }
  .x-cond-row:has(input:checked) .x-dot {
    background: var(--x-accent);
    border-color: var(--x-accent);
  }
