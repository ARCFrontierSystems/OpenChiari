---
/**
 * Home page. Matches design/mockups/Main.dc.html (desktop) and HomePhone.dc.html (phone).
 * All text comes from src/i18n/en.json, copied word for word from docs/COPY.md.
 */
import Base from '../layouts/Base.astro';
import ListenButton from '../components/ListenButton.astro';
import AnatomyFigure from '../components/AnatomyFigure.astro';
import { getStrings, getRoutes } from '../i18n';
const routes = getRoutes(Astro.currentLocale);

const h = getStrings(Astro.currentLocale).home;
const calm = getStrings(Astro.currentLocale).calm;
---

<Base>
  <div class="calm-note only-calm" role="status">
    <p><strong>{calm.noteStrong}</strong> {calm.noteRest}</p>
  </div>

  <section class="hero container">
    <div class="hero-intro">
      <p class="eyebrow mono">{h.eyebrow}</p>
      <h1 class="serif">{h.title}</h1>
      <p class="lede">
        <span class="only-wide">{h.lede.wide}</span><span class="only-narrow not-calm">{h.lede.narrow}</span><span class="only-narrow only-calm">{calm.lede}</span>
      </p>
    </div>

    <div class="hero-actions">
      <a class="button button-primary" href={routes.explorer}>{h.openExplorer}</a>
      <a class="button button-secondary not-calm" href={routes.tour}>{h.tour}</a>
      <p class="calm-explorer-note only-calm">{calm.explorerNote}</p>
    </div>

    <figure class="figure hero-figure">
      <div class="figure-art">
        <AnatomyFigure class="only-wide" condition="chiari" flow={false} labels={true} measure={true} />
        <AnatomyFigure class="only-narrow" condition="chiari" flow={false} labels={false} measure={true} />
      </div>
      <figcaption>
        <span class="fig-num mono">{h.figNumber}</span>
        <span class="only-wide">{h.figCaption.wide}</span><span class="only-narrow not-calm">{h.figCaption.narrow}</span><span class="only-narrow only-calm">{calm.figCaption}</span>
      </figcaption>
    </figure>
  </section>

  <section class="tools-band" aria-labelledby="tools">
    <div class="container">
      <h2 class="visually-hidden" id="tools">{h.tools.title}</h2>
      <div class="tool-groups">
        {h.tools.groups.map((group) => (
          <div class="tool-group">
            <h3 class="tools-group">{group.title}</h3>
            <ul class="tools">
              {group.pages.map((page) => h.tools.items.find((tool) => tool.page === page)!).map((tool) => (
                <li>
                  <a class="tool" href={routes[tool.page as keyof typeof routes]}>
                    <span class="tool-title">{tool.title}</span>
                    <span class="tool-desc">{tool.narrow}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="what-is">
    <div class="container band-inner">
      <h2 class="section-title" id="what-is">{h.whatIs.title}</h2>
      <ListenButton />
      <div class="facts">
        {[h.whatIs.whatItIs, h.whatIs.whoHasIt, h.whatIs.howFound].map((fact) => (
          <div class="fact">
            <h3>{fact.title}</h3>
            <p>
              <span class="only-wide">{fact.wide}</span><span class="only-narrow">{fact.narrow}</span>
            </p>
          </div>
        ))}
      </div>
      <aside class="say" aria-labelledby="say-title" data-no-listen>
        <h3 id="say-title">{h.say.title}</h3>
        <dl>
          {h.say.items.map((item) => (
            <div>
              <dt>{item.term}</dt>
              <dd class="mono" lang="en">{item.say}</dd>
            </div>
          ))}
        </dl>
        <p class="say-note">{h.say.key} {h.say.history}</p>
      </aside>
    </div>
  </section>

  <section class="band" aria-labelledby="feel">
    <div class="container band-inner feel">
      <div class="feel-intro">
        <h2 class="section-title" id="feel">{h.feel.title}</h2>
      <ListenButton />
        <p class="only-wide feel-lede">{h.feel.intro}</p>
        <blockquote class="classic serif">
          <span class="only-wide">{h.feel.classic.wide}</span><span class="only-narrow">{h.feel.classic.narrow}</span>
        </blockquote>
      </div>
      <div class="feel-list">
        <p class="list-label mono only-wide" id="symptoms-label">{h.feel.listLabel}</p>
        <ul class="symptoms" aria-labelledby="symptoms-label">
          {h.feel.symptoms.map((s) => (
            <li>
              <span class="only-wide">{s.wide}</span><span class="only-narrow">{s.narrow}</span>
            </li>
          ))}
        </ul>
        <p class="only-narrow no-symptoms">{h.feel.noSymptoms}</p>
      </div>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="myths">
    <div class="container band-inner">
      <h2 class="section-title" id="myths">{h.myths.title}</h2>
      <ListenButton />
      <dl class="myths">
        {h.myths.items.map((m) => (
          <div class="myth">
            <dt class="serif">{m.myth}</dt>
            <dd>
              <span class="only-wide">{m.wide}</span><span class="only-narrow">{m.narrow}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

</Base>

<style>
  /* ---------- Calm mode note (HomeCalm mockup) ---------- */
  .calm-note {
    max-width: var(--content-max);
    margin: var(--s-24) auto 0;
    padding: 0 var(--gutter);
  }
  .calm-note p {
    padding: 14px var(--s-16);
    background: var(--surface);
    border: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.5;
  }
  .calm-note strong {
    font-weight: 600;
  }
  .calm-explorer-note {
    flex: 1 1 100%;
    font-size: 16px;
    color: var(--ink-2);
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-top: var(--s-72);
    padding-bottom: 64px;
    display: grid;
    grid-template-columns: minmax(0, 420fr) minmax(0, 560fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'intro figure'
      'actions figure';
    column-gap: var(--s-56);
  }
  .hero-intro {
    grid-area: intro;
    display: flex;
    flex-direction: column;
    gap: var(--s-20);
    padding-top: var(--s-24);
  }
  .eyebrow {
    font-size: 13px;
    color: var(--muted);
  }
  h1 {
    font-size: var(--h1);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 500px;
  }
  .hero-actions {
    grid-area: actions;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    margin-top: 28px;
  }
  .hero-figure {
    grid-area: figure;
  }

  /* Figure: white surface, hairline border, caption bar with "Fig. N" in mono */
  .figure {
    background: var(--surface);
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
  }
  .figure-art {
    padding: var(--s-16) var(--s-16) 0;
  }
  .figure figcaption {
    border-top: 1px solid var(--rule);
    padding: var(--s-12) var(--s-16);
    font-size: 14px;
    color: var(--muted);
    display: flex;
    gap: var(--s-12);
  }
  .fig-num {
    color: var(--ink);
    flex: none;
  }

  /* ---------- Bands ---------- */
  .band {
    border-top: 1px solid var(--rule);
  }
  .band-surface {
    background: var(--surface);
  }
  .band-inner {
    padding-top: var(--s-72);
    padding-bottom: var(--s-72);
    display: flex;
    flex-direction: column;
    gap: var(--s-32);
  }

  /* What is Chiari */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    column-gap: var(--s-32);
    row-gap: var(--s-32);
  }
  .fact {
    border-top: 2px solid var(--ink);
    padding-top: var(--s-16);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .fact h3 {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }
  .fact p {
    color: var(--ink-2);
  }

  /* What it can feel like */
  .feel {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--s-56);
  }
  .feel-intro,
  .feel-list {
    flex: 1 1 400px;
    display: flex;
    flex-direction: column;
  }
  .feel-intro {
    gap: var(--s-16);
  }
  .feel-lede {
    color: var(--ink-2);
  }
  .classic {
    margin-top: var(--s-8);
    padding: 4px 0 4px var(--s-20);
    border-left: 3px solid var(--accent);
    font-size: 23px;
    line-height: 1.4;
  }
  .list-label {
    font-size: 13px;
    color: var(--muted);
    padding-bottom: var(--s-8);
  }
  .symptoms {
    list-style: none;
    padding: 0;
    font-size: 16px;
  }
  .symptoms li {
    border-top: 1px solid var(--rule);
    padding: var(--s-12) 0;
  }
  .symptoms li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* Common misunderstandings */
  .myths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    column-gap: var(--s-48);
    row-gap: var(--s-32);
  }
  .myth {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .myth dt {
    font-size: 22px;
    line-height: 1.35;
  }
  .myth dd {
    color: var(--ink-2);
  }

  /* Tools: a compact band under the opening picture, three groups side by side (Nov 5). */
  .tools-band {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: var(--s-24) 0;
  }
  .tool-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--s-16) var(--s-40);
  }
  .tools-group {
    margin: 0 0 var(--s-8);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .tools li {
    border-bottom: 1px solid var(--rule);
  }
  .tool {
    padding: 10px 0;
    min-height: var(--touch);
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--ink);
    text-decoration: none;
  }
  .tool-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--accent);
  }
  .tool:hover .tool-title {
    color: var(--accent-hover);
    text-decoration: underline;
  }
  .tool-desc {
    font-size: 14px;
    color: var(--ink-2);
  }

  /* ---------- Calm mode: larger text ---------- */
  :global(:root[data-calm='on']) .hero {
    padding-top: var(--s-56);
  }
  :global(:root[data-calm='on']) .eyebrow,
  :global(:root[data-calm='on']) .list-label,
  :global(:root[data-calm='on']) .tools-group {
    font-size: 15px;
  }
  :global(:root[data-calm='on']) .lede {
    font-size: 21px;
  }
  :global(:root[data-calm='on']) .figure figcaption {
    font-size: 16px;
    color: var(--ink-2);
  }
  :global(:root[data-calm='on']) .fact h3 {
    font-size: 20px;
  }
  :global(:root[data-calm='on']) .classic {
    font-size: 25px;
  }
  :global(:root[data-calm='on']) .symptoms {
    font-size: var(--text-base);
  }
  :global(:root[data-calm='on']) .myth dt {
    font-size: 24px;
  }
  :global(:root[data-calm='on']) .tool-title {
    font-size: 21px;
  }

  /* ---------- Tablet: hero stacks ---------- */
  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas:
        'intro'
        'actions'
        'figure';
      row-gap: var(--s-40);
    }
    .hero-actions {
      margin-top: 0;
    }
  }

  /* ---------- Phone (HomePhone mockup) ---------- */
  @media (max-width: 720px) {
    .hero {
      padding: var(--s-32) 0 0;
      grid-template-areas:
        'intro'
        'figure'
        'actions';
      row-gap: 0;
    }
    .hero-intro {
      padding: 0 var(--gutter) var(--s-24);
      gap: 14px;
    }
    .eyebrow {
      font-size: 12px;
    }
    h1 {
      line-height: 1.12;
      letter-spacing: 0;
    }
    .lede {
      font-size: 17px;
    }
    .hero-figure {
      margin: 0 var(--gutter);
    }
    .figure-art {
      padding: var(--s-8);
    }
    .figure figcaption {
      display: block;
      padding: 10px var(--s-12);
      font-size: 13px;
    }
    .fig-num {
      margin-right: 0.35em;
    }
    .hero-actions {
      flex-direction: column;
      gap: var(--s-8);
      padding: var(--s-16) var(--gutter) var(--s-40);
    }
    .hero-actions .button {
      width: 100%;
    }

    .band-inner {
      padding-top: var(--s-40);
      padding-bottom: var(--s-40);
      gap: var(--s-20);
    }
    .facts {
      row-gap: var(--s-20);
    }
    .fact {
      padding-top: var(--s-12);
      gap: var(--s-4);
    }
    .fact h3 {
      font-size: 17px;
    }

    .feel {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: var(--s-16);
    }
    .feel-intro,
    .feel-list {
      flex: none;
    }
    .feel-list {
      gap: var(--s-16);
    }
    .classic {
      margin-top: 0;
      padding: 2px 0 2px var(--s-16);
      font-size: 19px;
    }
    .symptoms li {
      padding: 10px 0;
    }
    .no-symptoms {
      font-size: 15px;
      color: var(--muted);
    }

    .myths {
      row-gap: var(--s-20);
    }
    .myth {
      gap: 6px;
    }
    .myth dt {
      font-size: 19px;
    }

    .tool-title {
      font-size: 16px;
    }

    /* Calm mode on phones (HomeCalm mockup) */
    .calm-note {
      margin-top: var(--s-16);
    }
    :global(:root[data-calm='on']) .hero {
      padding-top: 28px;
    }
    :global(:root[data-calm='on']) .hero-intro {
      padding-bottom: var(--s-20);
    }
    :global(:root[data-calm='on']) .eyebrow {
      display: none;
    }
    :global(:root[data-calm='on']) h1 {
      font-size: 36px;
      line-height: 1.15;
    }
    :global(:root[data-calm='on']) .lede {
      font-size: var(--text-base);
    }
    :global(:root[data-calm='on']) .fig-num {
      display: none;
    }
    :global(:root[data-calm='on']) .figure figcaption {
      padding: var(--s-12);
    }
    :global(:root[data-calm='on']) .hero-actions {
      gap: 10px;
      padding: var(--s-20) var(--gutter) var(--s-32);
    }
    :global(:root[data-calm='on']) .section-title {
      font-size: 28px;
    }
    :global(:root[data-calm='on']) .band-inner {
      padding-top: var(--s-32);
      padding-bottom: var(--s-32);
    }
    :global(:root[data-calm='on']) .fact h3 {
      font-size: 19px;
    }
    :global(:root[data-calm='on']) .classic {
      font-size: 21px;
    }
    :global(:root[data-calm='on']) .no-symptoms {
      font-size: 17px;
    }
    :global(:root[data-calm='on']) .myth dt {
      font-size: 21px;
    }
    :global(:root[data-calm='on']) .tool-title {
      font-size: 19px;
    }
    :global(:root[data-calm='on']) .tool-desc {
      font-size: 17px;
    }
  }
  /* How do you say it? (approved 2026-11-05; EVIDENCE.md "Pronunciation") */
  .say {
    margin-top: var(--s-32);
    padding: var(--s-20) var(--s-24);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
  }
  .say h3 {
    margin: 0 0 var(--s-12);
    font-size: 17px;
  }
  .say dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s-12) var(--s-24);
  }
  .say dt {
    font-weight: 600;
  }
  .say dd {
    margin: 2px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  .say-note {
    margin: var(--s-16) 0 0;
    font-size: var(--text-small);
    color: var(--muted);
  }
</style>
