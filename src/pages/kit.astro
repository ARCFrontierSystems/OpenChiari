---
/**
 * Awareness kit (Chiari Awareness Month, September). Layout from design/mockups/Kit.dc.html; text from
 * src/i18n/en.json (docs/COPY.md "Awareness kit"). The files themselves are made by scripts/make-kit.mjs into
 * public/kit/ (run it again after the text or figure changes). No donation handling (CLAUDE.md "Don't").
 */
import Base from '../layouts/Base.astro';
import { getStrings, routes } from '../i18n';

const s = getStrings();
const k = s.kit;
const items = [
  { id: 'social', preview: '/kit/preview-social.png', alt: `${k.socialHeadline} ${k.socialFooter}`, files: [{ href: '/kit/social-post.png', label: 'PNG' }] },
  {
    id: 'quote',
    preview: '/kit/preview-quote.png',
    alt: `${k.quote} ${k.quoteFooter}`,
    files: [
      { href: '/kit/quote-card-square.png', label: '1080 × 1080' },
      { href: '/kit/quote-card-story.png', label: '1080 × 1920' },
    ],
  },
  { id: 'card', preview: '/kit/preview-cards.png', alt: `${k.cardLine1} ${k.cardLine2}`, files: [{ href: '/kit/wallet-cards.pdf', label: 'PDF' }] },
  {
    id: 'poster',
    preview: '/kit/preview-poster.png',
    alt: `${k.posterTitle} ${k.logoSpace}`,
    files: [
      { href: '/kit/poster-letter.pdf', label: 'Letter' },
      { href: '/kit/poster-a4.pdf', label: 'A4' },
    ],
  },
] as const;
---

<Base title={k.title}>
  <div class="kit container">
    <div class="page-intro">
      <div>
        <p class="eyebrow mono">{k.eyebrow}</p>
        <h1 class="serif">{k.title}</h1>
        <p>{k.intro}</p>
      </div>
      <a class="button button-primary" href="/kit/open-chiari-awareness-kit.zip" download>{k.zip}</a>
    </div>

    <ul class="items">
      {items.map((item) => (
        <li class="item">
          <figure>
            <div class="frame"><img src={item.preview} alt={item.alt} loading="lazy" /></div>
            <figcaption>
              <span class="item-title">{k.items[item.id].title}</span>
              <span class="mono">{k.items[item.id].format}</span>
            </figcaption>
          </figure>
          <p class="links">
            {item.files.map((f) => (
              <a href={f.href} download>{k.download} {f.label}</a>
            ))}
          </p>
        </li>
      ))}
    </ul>

    <section class="orgs" aria-labelledby="orgs-title">
      <div>
        <h2 id="orgs-title" class="serif">{k.orgsTitle}</h2>
        <p>{k.orgsText}</p>
      </div>
      <a class="button button-secondary" href={routes.about}>{k.contact}</a>
    </section>

    <p class="license">{k.license}</p>
  </div>
</Base>

<style>
  .kit {
    padding-top: var(--s-48);
    padding-bottom: var(--s-72);
  }
  .page-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-24) var(--s-40);
    margin-bottom: var(--s-40);
  }
  .eyebrow {
    font-size: var(--text-mono);
    color: var(--awareness);
    margin-bottom: var(--s-8);
  }
  .page-intro h1 {
    font-size: var(--h1);
    line-height: 1.08;
    margin-bottom: var(--s-16);
  }
  .page-intro p {
    max-width: 40em;
    color: var(--ink-2);
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-24);
  }
  .item figure {
    margin: 0;
  }
  .frame {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-16);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .frame img {
    max-width: 100%;
    max-height: 100%;
    box-shadow: 0 0 0 1px var(--rule);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--s-12);
  }
  .item-title {
    font-weight: 600;
  }
  figcaption .mono {
    font-size: var(--text-mono);
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-16);
    margin-top: var(--s-4);
  }
  .links a {
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
  }
  .orgs {
    margin-top: var(--s-48);
    padding: var(--s-24);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-16) var(--s-32);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--awareness);
  }
  .orgs h2 {
    font-size: 24px;
    margin-bottom: var(--s-8);
  }
  .orgs p {
    max-width: 40em;
  }
  .license {
    margin-top: var(--s-24);
    font-size: var(--text-small);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .page-intro h1 {
      font-size: 34px;
    }
  }
</style>
