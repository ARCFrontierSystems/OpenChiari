---
/**
 * Awareness kit (Chiari Awareness Month, September). Layout from design/mockups/Kit.dc.html; text from
 * src/i18n/en.json (docs/COPY.md "Awareness kit"). The files themselves are made by scripts/make-kit.mjs into
 * public/kit/ (run it again after the text or figure changes). No donation handling (CLAUDE.md "Don't").
 */
import Base from '../layouts/Base.astro';
import AnatomyFigure from '../components/AnatomyFigure.astro';
import { ribbonSvg } from '../lib/ribbon';
import { getStrings, getRoutes } from '../i18n';
const routes = getRoutes(Astro.currentLocale);

const s = getStrings(Astro.currentLocale);
const k = s.kit;
// Spanish pages offer the Spanish files (made by make-kit.mjs --locale es into public/kit/es/).
const base = Astro.currentLocale === 'es' ? '/kit/es/' : '/kit/';
const fig = s.figure.ariaPrefix + s.figure.aria.chiari + '.';
const b = k.builder;
// The model credit exactly as CLAUDE.md rule 3 gives it, and the approved Chiari I caption (the poster shows the figure).
const f = s.footer;
const credit = `${f.modelBefore.replace(/^\.\s*/, '')} ${f.zAnatomy} ${f.modelAfter}`;
const caption = s.home.figCaption.narrow;
const notAdvice = `${f.notAdvice} ${f.notAdviceRest.wide}`;
const spanishNotice = Astro.currentLocale === 'es' ? s.translation.noticeShort : '';
// Sticker starters: the approved phrases from the two ready-made sheets, without repeats.
const starters = [...new Set([...k.stickers.sheets.everyone.messages, ...k.stickers.sheets.surgery.messages])];
const items = [
  { id: 'social', preview: base + 'preview-social.png', alt: `${k.explain.headline} ${k.explain.lines.join(' ')} ${fig} ${k.explain.footer}`, files: [{ href: base + 'social-post.png', label: 'PNG' }] },
  {
    id: 'quote',
    preview: base + 'preview-quote.png',
    alt: `${k.quote} ${k.quoteFooter}`,
    files: [
      { href: base + 'quote-card-square.png', label: '1080 × 1080' },
      { href: base + 'quote-card-story.png', label: '1080 × 1920' },
    ],
  },
  { id: 'card', preview: base + 'preview-cards.png', alt: `${k.cardLine1} ${k.cardLine2}`, files: [{ href: base + 'wallet-cards.pdf', label: 'PDF' }] },
  {
    id: 'poster',
    preview: base + 'preview-poster.png',
    alt: `${k.posterTitle} ${fig} ${k.logoSpace}`,
    files: [
      { href: base + 'poster-letter.pdf', label: k.letter },
      { href: base + 'poster-a4.pdf', label: 'A4' },
    ],
  },
  ...(['everyone', 'surgery'] as const).map((sheet) => ({
    id: sheet === 'everyone' ? ('stickersEveryone' as const) : ('stickersSurgery' as const),
    preview: base + `preview-stickers-${sheet}.png`,
    alt: `${k.stickers.sheets[sheet].title}: ${k.stickers.sheets[sheet].messages.join(', ')}. ${k.stickers.blank}.`,
    files: [
      { href: base + `stickers-${sheet}-letter.pdf`, label: k.letter },
      { href: base + `stickers-${sheet}-a4.pdf`, label: 'A4' },
    ],
  })),
] as const;
---

<Base title={k.title}>
  <div class="kit container">
    <div class="page-intro">
      <div>
        <p class="eyebrow mono">{k.eyebrow}</p>
        <h1 class="serif">{k.title}</h1>
        <p>{k.intro}</p>
      </div>
      <a class="button button-primary" href={base + 'open-chiari-awareness-kit.zip'} download>{k.zip}</a>
    </div>

    <ul class="items">
      {items.map((item) => (
        <li class="item">
          <figure>
            <div class="frame"><img src={item.preview} alt={item.alt} loading="lazy" /></div>
            <figcaption>
              <span class="item-title">{k.items[item.id].title}</span>
              <span class="mono">{k.items[item.id].format}</span>
            </figcaption>
          </figure>
          <p class="links">
            {item.files.map((f) => (
              <a href={f.href} download>{k.download} {f.label}</a>
            ))}
          </p>
          {(item.id === 'social' || item.id === 'quote') && (
            <p class="alt-copy">
              <button type="button" class="link-button" data-copy-alt={item.alt}>{k.copyAlt}</button>
              <span class="alt-done" role="status" data-alt-done></span>
            </p>
          )}
        </li>
      ))}
    </ul>

    <section class="orgs" aria-labelledby="orgs-title">
      <div>
        <h2 id="orgs-title" class="serif">{k.orgsTitle}</h2>
        <p>{k.orgsText}</p>
      </div>
      <a class="button button-secondary" href="#make">{b.title}</a>
    </section>

    <section class="builder" id="make" aria-labelledby="make-title">
      <h2 id="make-title" class="serif">{b.title}</h2>
      <p class="builder-intro">{b.intro}</p>
      <div class="builder-layout">
        <div class="builder-preview" data-preview>
          <div class="preview-bar">
            <p class="preview-title">{b.preview}</p>
            <button type="button" class="preview-size" data-preview-size aria-pressed="false">{b.enlarge}</button>
          </div>
          <div class="preview-stage">
            <canvas data-builder-canvas role="img" aria-label={b.preview}></canvas>
            <div class="sheet-frame" data-sheet-frame hidden>
              <div class="sheet" data-sheet>
                <div class="poster" data-poster hidden>
                  <div class="poster-band">
                    <p class="poster-label"><span class="poster-ribbon" set:html={ribbonSvg('currentColor')} />{b.label}</p>
                    <img class="poster-image" data-poster-image alt={b.imageAlt} hidden />
                  </div>
                  <div class="poster-body">
                    <p class="poster-title serif" data-out="message"></p>
                    <p class="poster-answer" data-out="answer"></p>
                    <div class="poster-figure" data-poster-figure><AnatomyFigure condition="chiari" flow={false} labels={false} measure={true} /></div>
                    <div class="poster-own" data-out-wrap="own"><p data-out="own"></p></div>
                    <p class="poster-meta" data-out="name"></p>
                    <p class="poster-meta" data-out="when"></p>
                    <div class="poster-foot">
                      <p class="mono poster-site">openchiari.org</p>
                      <p><strong>{f.notAdvice}</strong> {f.notAdviceRest.wide} <span data-poster-credit>{caption}</span></p>
                      <p data-poster-credit>{credit}</p>
                      {spanishNotice && <p>{spanishNotice}</p>}
                    </div>
                  </div>
                </div>
                <div class="sticker-sheet" data-stickers hidden>
                  {Array.from({ length: 12 }, () => <div class="sticker"><span class="sticker-ribbon" set:html={ribbonSvg('currentColor')} /><p data-sticker-text></p></div>)}
                </div>
              </div>
            </div>
          </div>
        </div>

        <form class="builder-form" data-builder autocomplete="off">
          <fieldset class="step">
            <legend class="step-title"><span class="step-num" aria-hidden="true">1</span>{b.step1}</legend>
            <div class="design-cards">
              {Object.entries(b.designs).map(([id, d], i) => (
                <label class="card design-card">
                  <input type="radio" name="design" value={id} checked={i === 0} />
                  <span class={`design-shape shape-${id}`} aria-hidden="true"></span>
                  <span class="card-text"><span class="card-label">{d.label}</span><span class="card-hint">{d.hint}</span></span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="step">
            <h3 class="step-title"><span class="step-num" aria-hidden="true">2</span>{b.step2}</h3>
            <fieldset class="field" data-for="graphic">
              <legend>{b.message}</legend>
              <small id="message-hint">{b.messageHint}</small>
              <div class="message-cards">
                {b.messages.map((m, i) => (
                  <label class="card message-card">
                    <input type="radio" name="message" value={String(i)} checked={i === 0} aria-describedby="message-hint" />
                    <span class="card-text">
                      <span class="message-text">{m.text}</span>
                      {'answer' in m && m.answer && <span class="message-answer">{m.answer}</span>}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="field" data-for="graphic">
              <label for="builder-own">{b.own}</label>
              <input id="builder-own" type="text" maxlength="120" placeholder={b.ownHint} data-field="own" aria-describedby="own-yours own-count" />
              <small id="own-yours">{b.yours}</small>
              <small id="own-count" class="counter" data-counter></small>
            </div>
            <div class="field" data-for="graphic">
              <label for="builder-name">{b.name}</label>
              <input id="builder-name" type="text" maxlength="80" data-field="name" />
            </div>
            <div class="field" data-for="graphic">
              <label for="builder-when">{b.when}</label>
              <input id="builder-when" type="text" maxlength="80" data-field="when" />
            </div>
            <div class="field" data-for="stickers" hidden>
              <label for="builder-sticker">{b.stickerText}</label>
              <textarea id="builder-sticker" rows="3" maxlength="60" data-field="sticker" aria-describedby="sticker-hint">{b.stickerDefault}</textarea>
              <small id="sticker-hint">{b.stickerHint}</small>
              <p class="starters-title" id="starters-title">{b.starters}</p>
              <div class="starters" role="group" aria-labelledby="starters-title">
                {starters.map((phrase) => <button type="button" class="starter" data-starter={phrase}>{phrase}</button>)}
              </div>
            </div>
          </div>

          <div class="step">
            <h3 class="step-title"><span class="step-num" aria-hidden="true">3</span>{b.step3}</h3>
            <fieldset class="field">
              <legend>{b.color}</legend>
              <div class="swatches">
                {Object.entries(b.colors).map(([id, label], i) => (
                  <label class="swatch">
                    <input type="radio" name="theme" value={id} checked={i === 0} />
                    <span class={`swatch-chip chip-${id}`} aria-hidden="true"></span>
                    {label}
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="field" data-for="figure">
              <label class="check"><input type="checkbox" data-field="figure" aria-describedby="figure-hint" /> {b.figure}</label>
              <small id="figure-hint">{b.figureHint}</small>
            </div>
            <div class="field" data-for="image">
              <label for="builder-image">{b.image}</label>
              <input id="builder-image" type="file" accept="image/png, image/jpeg, image/webp" data-field="image" aria-describedby="image-hint" />
              <small id="image-hint">{b.imageHint}</small>
              <div class="image-chosen" data-image-chosen hidden>
                <img data-image-thumb alt={b.imageAlt} />
                <button type="button" class="button button-secondary" data-remove-image>{b.removeImage}</button>
              </div>
            </div>
            <fieldset class="field" data-for="print" hidden>
              <legend>{b.size}</legend>
              <div class="inline-choices">
                <label class="choice"><input type="radio" name="paper" value="letter" checked /> {k.letter}</label>
                <label class="choice"><input type="radio" name="paper" value="A4" /> A4</label>
              </div>
            </fieldset>
            <div class="builder-actions">
              <button type="button" class="button button-primary" data-builder-download>{b.download}</button>
              <button type="button" class="button button-primary" data-builder-print hidden>{b.print}</button>
              <p class="alt-copy" data-for-graphic-alt>
                <button type="button" class="link-button" data-copy-alt data-builder-alt>{k.copyAlt}</button>
                <span class="alt-done" role="status" data-alt-done></span>
              </p>
            </div>
          </div>
        </form>
      </div>
    </section>


    <p class="license">{k.license}</p>
  </div>
</Base>

<script>
  import strings from '../i18n/client';
  import { drawGraphic, loadFigure, type Shape, type Theme } from '../lib/kit-builder';
  import { anatomyFigureSvg } from '../lib/anatomy-figure';

  // Everything below runs on the visitor's device. Nothing is uploaded, sent or stored.
  const b = strings.kit.builder;
  const f = strings.footer;
  const spanish = document.documentElement.lang === 'es';
  const form = document.querySelector<HTMLFormElement>('[data-builder]')!;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-builder-canvas]')!;
  const frame = document.querySelector<HTMLElement>('[data-sheet-frame]')!;
  const preview = document.querySelector<HTMLElement>('[data-preview]')!;
  const sizeButton = document.querySelector<HTMLButtonElement>('[data-preview-size]')!;
  const root = document.documentElement;
  const credit = `${f.modelBefore.replace(/^\.\s*/, '')} ${f.zAnatomy} ${f.modelAfter}`;
  let image: ImageBitmap | null = null;
  let imageUrl = '';
  let figure: HTMLImageElement | null = null;
  // The picture is off at first for posts and stories, and on for the poster; each design remembers its own choice.
  const figureOn: Record<string, boolean> = { square: false, story: false, poster: true };
  let lastDesign = '';
  form.addEventListener('submit', (e) => e.preventDefault());

  const field = <T extends HTMLElement>(name: string) => form.querySelector<T>(`[data-field="${name}"]`)!;
  const value = (name: string) => field<HTMLInputElement | HTMLTextAreaElement>(name).value.trim();
  const picked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!.value;
  const message = () => b.messages[Number(picked('message'))] as { text: string; answer?: string };
  const show = (selector: string, on: boolean) => form.querySelectorAll<HTMLElement>(selector).forEach((el) => (el.hidden = !on));

  /** The scaled print sheet fills the preview's width (8.5 in = 816 px). */
  const fitSheet = () => frame.style.setProperty('--sheet-scale', String(frame.clientWidth / 816));
  new ResizeObserver(fitSheet).observe(frame);

  function counter() {
    const input = field<HTMLInputElement>('own');
    const max = input.maxLength;
    form.querySelector<HTMLElement>('[data-counter]')!.textContent = b.counter.replace('{left}', String(max - input.value.length)).replace('{max}', String(max));
  }

  /** What the preview shows, in words, for screen readers. */
  function describe(design: string, theme: string, showFigure: boolean): string {
    const parts = [`${b.preview}: ${b.designs[design as keyof typeof b.designs].label}, ${b.colors[theme as keyof typeof b.colors]}.`];
    if (design === 'stickers') parts.push(value('sticker').replace(/\n+/g, ' '));
    else {
      const m = message();
      parts.push(`${b.describe.message}: ${m.text}${m.answer ? ' ' + m.answer : ''}`);
      if (value('own')) parts.push(`${b.describe.own}: ${value('own')}`);
      parts.push(...[value('name'), value('when')].filter(Boolean));
      if (showFigure) parts.push(b.describe.figure);
      if (image) parts.push(b.describe.image);
    }
    return parts.join(' ');
  }

  /** The image description to paste when posting (no "Preview:", just what the graphic shows). */
  function altText(showFigure: boolean): string {
    const m = message();
    return [`${b.label}.`, m.text, m.answer ?? '', value('own'), value('name'), value('when'), showFigure ? strings.figure.ariaPrefix + strings.figure.aria.chiari + '.' : '', 'openchiari.org']
      .filter(Boolean)
      .join(' ');
  }

  async function render() {
    const design = picked('design');
    const theme = picked('theme') as Theme;
    const graphic = design === 'square' || design === 'story';
    const figureBox = field<HTMLInputElement>('figure');
    if (design !== lastDesign && design in figureOn) figureBox.checked = figureOn[design];
    lastDesign = design;
    const showFigure = design !== 'stickers' && figureBox.checked;
    show('[data-for="graphic"], [data-for="figure"], [data-for="image"]', design !== 'stickers');
    show('[data-for="stickers"]', design === 'stickers');
    show('[data-for="print"]', !graphic);
    document.querySelector<HTMLElement>('[data-builder-download]')!.hidden = !graphic;
    document.querySelector<HTMLElement>('[data-builder-print]')!.hidden = graphic;
    canvas.hidden = !graphic;
    frame.hidden = graphic;
    preview.dataset.design = design;
    frame.dataset.theme = theme;
    frame.dataset.design = design;
    counter();
    const description = describe(design, theme, showFigure);
    canvas.setAttribute('aria-label', description);
    document.querySelector<HTMLElement>('[data-builder-alt]')!.dataset.copyAlt = altText(showFigure);
    document.querySelector<HTMLElement>('[data-for-graphic-alt]')!.hidden = !graphic;
    if (graphic) {
      if (showFigure && !figure) figure = await loadFigure(anatomyFigureSvg({ condition: 'chiari', flow: false, labels: false, measure: true }, strings.figure));
      const m = message();
      await drawGraphic(canvas, {
        shape: design as Shape,
        theme,
        label: b.label,
        message: m.text,
        answer: m.answer,
        own: value('own'),
        name: value('name'),
        when: value('when'),
        image,
        figure: showFigure ? figure : null,
        site: 'openchiari.org',
        small: [`${f.notAdvice} ${f.notAdviceRest.wide}`, showFigure ? `${strings.home.figCaption.narrow} ${credit}` : '', spanish ? strings.translation.noticeShort : ''].filter(Boolean).join(' '),
      });
      return;
    }
    fitSheet();
    // Poster and stickers are pages to print; their text is set as text only, never as HTML.
    document.querySelector<HTMLElement>('[data-poster]')!.hidden = design !== 'poster';
    document.querySelector<HTMLElement>('[data-stickers]')!.hidden = design !== 'stickers';
    const m = message();
    const out: Record<string, string> = { message: m.text, answer: m.answer ?? '', own: value('own'), name: value('name'), when: value('when') };
    for (const key of Object.keys(out)) {
      document.querySelectorAll<HTMLElement>(`[data-out="${key}"]`).forEach((el) => (el.textContent = out[key]));
    }
    document.querySelector<HTMLElement>('[data-out-wrap="own"]')!.hidden = !value('own');
    document.querySelector<HTMLElement>('[data-poster-figure]')!.hidden = !showFigure;
    document.querySelectorAll<HTMLElement>('[data-poster-credit]').forEach((el) => (el.hidden = !showFigure));
    const posterImage = document.querySelector<HTMLImageElement>('[data-poster-image]')!;
    posterImage.hidden = !imageUrl;
    if (imageUrl) posterImage.src = imageUrl;
    const words = value('sticker');
    document.querySelectorAll<HTMLElement>('[data-sticker-text]').forEach((el) => (el.textContent = words));
  }

  form.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    // Stickers: at most 3 lines.
    if (target.matches('[data-field="sticker"]')) {
      const area = target as HTMLTextAreaElement;
      const kept = area.value.split('\n').slice(0, 3).join('\n');
      if (kept !== area.value) area.value = kept;
    }
    void render();
  });
  form.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.matches('[data-field="figure"]')) figureOn[picked('design')] = target.checked;
    void render();
  });
  form.querySelectorAll<HTMLButtonElement>('[data-starter]').forEach((button) =>
    button.addEventListener('click', () => {
      field<HTMLTextAreaElement>('sticker').value = button.dataset.starter!;
      void render();
    }),
  );

  const chosen = document.querySelector<HTMLElement>('[data-image-chosen]')!;
  const thumb = document.querySelector<HTMLImageElement>('[data-image-thumb]')!;
  field<HTMLInputElement>('image').addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    image = await createImageBitmap(file);
    if (imageUrl) URL.revokeObjectURL(imageUrl);
    imageUrl = URL.createObjectURL(file);
    thumb.src = imageUrl;
    chosen.hidden = false;
    void render();
  });
  document.querySelector('[data-remove-image]')!.addEventListener('click', () => {
    image = null;
    if (imageUrl) URL.revokeObjectURL(imageUrl);
    imageUrl = '';
    field<HTMLInputElement>('image').value = '';
    chosen.hidden = true;
    field<HTMLInputElement>('image').focus();
    void render();
  });

  // Phones: the preview stays in a small bar at the top while you fill in the steps; this button shows it full size.
  sizeButton.addEventListener('click', () => {
    const big = sizeButton.getAttribute('aria-pressed') !== 'true';
    sizeButton.setAttribute('aria-pressed', String(big));
    sizeButton.textContent = big ? b.shrink : b.enlarge;
    preview.classList.toggle('is-big', big);
    fitSheet();
  });

  document.querySelector('[data-builder-download]')!.addEventListener('click', async () => {
    await render();
    canvas.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `open-chiari-${picked('design')}.png`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 10000);
    }, 'image/png');
  });

  // Printing: only the sheet prints, at the paper size chosen.
  const pageStyle = document.createElement('style');
  document.head.append(pageStyle);
  document.querySelector('[data-builder-print]')!.addEventListener('click', async () => {
    await render();
    pageStyle.textContent = `@page { size: ${picked('paper') === 'A4' ? 'A4' : 'letter'}; margin: 0; }`;
    root.dataset.printing = 'kit';
    window.print();
  });
  window.addEventListener('afterprint', () => delete root.dataset.printing);

  // "Copy image description": the words go to the clipboard, and a short note says where to paste them.
  const kitStrings = strings.kit;
  document.querySelectorAll<HTMLButtonElement>('[data-copy-alt]').forEach((button) =>
    button.addEventListener('click', async () => {
      const done = button.parentElement!.querySelector<HTMLElement>('[data-alt-done]')!;
      try {
        await navigator.clipboard.writeText(button.dataset.copyAlt ?? '');
        done.textContent = kitStrings.copiedAlt;
      } catch {
        done.textContent = button.dataset.copyAlt ?? '';
      }
    }),
  );

  void render();
</script>

<style>
  .kit {
    padding-top: var(--s-48);
    padding-bottom: var(--s-72);
  }
  .page-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-24) var(--s-40);
    margin-bottom: var(--s-40);
  }
  .eyebrow {
    font-size: var(--text-mono);
    color: var(--awareness);
    margin-bottom: var(--s-8);
  }
  .page-intro h1 {
    font-size: var(--h1);
    line-height: 1.08;
    margin-bottom: var(--s-16);
  }
  .page-intro p {
    max-width: 40em;
    color: var(--ink-2);
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-24);
  }
  .item figure {
    margin: 0;
  }
  .frame {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-16);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .frame img {
    max-width: 100%;
    max-height: 100%;
    box-shadow: 0 0 0 1px var(--rule);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--s-12);
  }
  .item-title {
    font-weight: 600;
  }
  figcaption .mono {
    font-size: var(--text-mono);
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-16);
    margin-top: var(--s-4);
  }
  .links a {
    min-height: var(--touch);
    display: inline-flex;
    align-items: center;
  }
  .orgs {
    margin-top: var(--s-48);
    padding: var(--s-24);
    display: flex;
