---
/**
 * Reading your MRI report (Phase B, Nov 5): words people find on an MRI report about Chiari, in plain language, each
 * with a link to the matching 3D view. Text from src/i18n/en.json ("mri"), drafted with its sources in
 * docs/drafts/2026-11-05-mri-report-and-warning-signs.md and checked in docs/audits/2026-11-05-mri-and-warning-signs-audit.md.
 * It explains words; it never interprets anyone's scan (CLAUDE.md: no diagnosis).
 */
import Base from '../layouts/Base.astro';
import NextStep from '../components/NextStep.astro';
import ListenButton from '../components/ListenButton.astro';
import { getStrings, getRoutes } from '../i18n';

const s = getStrings(Astro.currentLocale);
const t = s.mri;
const routes = getRoutes(Astro.currentLocale);
---

<Base title={t.title} description={t.metaDescription}>
  <div class="mri container">
    <div class="page-intro">
      <h1 class="serif">{t.title}</h1>
      <p class="lede">{t.intro}</p>
      <p class="note"><strong>{s.footer.notAdvice}</strong> {t.note}</p>
    </div>

    <nav class="term-index" aria-labelledby="term-index-title">
      <h2 id="term-index-title" class="index-title mono">{t.indexTitle}</h2>
      <ul>
        {t.terms.map((term) => <li><a href={`#${term.id}`}>{term.name}</a></li>)}
      </ul>
    </nav>

    <ListenButton target="[data-terms]" />
    <div class="terms" data-terms>
      {t.terms.map((term) => (
        <section class="term" id={term.id} aria-labelledby={`${term.id}-name`}>
          <h2 class="term-name serif" id={`${term.id}-name`}>{term.name}</h2>
          {term.also && <p class="also"><span class="mono">{t.alsoLabel}</span> {term.also}</p>}
          {term.text.map((para) => <p>{para}</p>)}
          {term.view && <a class="see-it" href={`${routes.explorer}#${term.view}`}>{t.seeIt}</a>}
        </section>
      ))}
    </div>

    <aside class="next">
      <p>{t.nextBefore} <a href={routes.prep}>{t.nextLink}</a>{t.nextAfter}</p>
      <p class="sources">{t.sourcesBefore} <a href={routes.evidence}>{t.sourcesLink}</a>.</p>
    </aside>
    <NextStep from="mri" />
  </div>
</Base>

<style>
  .mri {
    padding-top: var(--s-56);
    padding-bottom: var(--s-72);
    max-width: 50rem;
  }
  .page-intro h1 {
    font-size: var(--h1-page);
    line-height: 1.08;
    margin-bottom: var(--s-16);
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    margin: 0 0 var(--s-12);
  }
  .note {
    margin: 0;
    padding: var(--s-12) var(--s-16);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    font-size: var(--text-small);
  }
  .term-index {
    margin: var(--s-32) 0 var(--s-24);
  }
  .index-title {
    font-size: var(--text-mono);
    font-weight: 400;
    color: var(--muted);
    margin: 0 0 var(--s-8);
  }
  .term-index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-16);
  }
  .term-index a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .terms {
    margin-top: var(--s-16);
    border-top: 2px solid var(--ink);
  }
  .term {
    padding: var(--s-24) 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: var(--s-16);
  }
  .term-name {
    font-size: 24px;
    line-height: 1.2;
    margin: 0 0 var(--s-8);
  }
  .also {
    margin: 0 0 var(--s-8);
    color: var(--ink-2);
    font-size: var(--text-small);
  }
  .also .mono {
    color: var(--muted);
    font-size: var(--text-mono);
  }
  .term p {
    max-width: 40em;
    margin: 0 0 var(--s-8);
  }
  .see-it {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-weight: 600;
  }
  .next {
    margin-top: var(--s-32);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .next p {
    margin: 0;
  }
  .sources {
    font-size: var(--text-small);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .page-intro h1 {
      font-size: var(--h1-page);
    }
  }
  :global(:root[data-calm='on']) .term p {
    font-size: 19px;
  }
</style>
