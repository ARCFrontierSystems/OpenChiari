---
/**
 * Reading your MRI report (Phase B, Nov 5): words people find on an MRI report about Chiari, in plain language, each
 * with a link to the matching 3D view. Text from src/i18n/en.json ("mri"), drafted with its sources in
 * docs/drafts/2026-11-05-mri-report-and-warning-signs.md and checked in docs/audits/2026-11-05-mri-and-warning-signs-audit.md.
 * It explains words; it never interprets anyone's scan (CLAUDE.md: no diagnosis).
 */
import Base from '../layouts/Base.astro';
import NextStep from '../components/NextStep.astro';
import ListenButton from '../components/ListenButton.astro';
import { getStrings, getRoutes } from '../i18n';
import mriMarkers from '../lib/mri-markers.json';

const s = getStrings(Astro.currentLocale);
const t = s.mri;
const routes = getRoutes(Astro.currentLocale);
const v = t.view;
const parts = s.explorer.parts;
// Each marker's 3D view: typical anatomy, side view, with that structure picked (fluid flow on for the fluid).
const viewFor = (part: string) => `typ.side.l${part === 'csf' ? '.f' : ''}.p${part}`;
---

<Base title={t.title} description={t.metaDescription}>
  <div class="mri container">
    <div class="page-intro">
      <h1 class="serif">{t.title}</h1>
      <p class="lede">{t.intro}</p>
      <p class="note"><strong>{s.footer.notAdvice}</strong> {t.note}</p>
    </div>

    <section class="mri-view" id="mri-view" aria-labelledby="mri-view-title">
      <h2 id="mri-view-title" class="serif">{v.title}</h2>
      <p>{v.intro}</p>
      <div class="mri-layout">
        <figure class="mri-figure">
          <div class="mri-image">
            <img src="/mri/sagittal-t2.png" width={mriMarkers.width} height={mriMarkers.height} alt={v.alt} loading="lazy" />
            {mriMarkers.markers.map((m) => (
              <span class="mri-marker mono" style={`left:${m.x}%;top:${m.y}%`} aria-hidden="true">{m.num}</span>
            ))}
          </div>
          <figcaption>{v.caption}</figcaption>
        </figure>
        <div class="mri-legend">
          <ol>
            {mriMarkers.markers.map((m) => {
              const part = parts.find((pp) => pp.id === m.part)!;
              return (
                <li>
                  <span class="mri-num mono" aria-hidden="true">{m.num}</span>
                  <span class="mri-name">{part.name}</span>
                  <a href={`${routes.explorer}#${viewFor(m.part)}`}>{v.seeIt}</a>
                </li>
              );
            })}
          </ol>
          <p class="mri-note">{v.notMarked}</p>
          <p class="mri-credit">{v.credit}</p>
        </div>
      </div>
    </section>

    <nav class="term-index" aria-labelledby="term-index-title">
      <h2 id="term-index-title" class="index-title mono">{t.indexTitle}</h2>
      <ul>
        {t.terms.map((term) => <li><a href={`#${term.id}`}>{term.name}</a></li>)}
      </ul>
    </nav>

    <ListenButton target="[data-terms]" />
    <div class="terms" data-terms>
      {t.terms.map((term) => (
        <section class="term" id={term.id} aria-labelledby={`${term.id}-name`}>
          <h2 class="term-name serif" id={`${term.id}-name`}>{term.name}</h2>
          {term.also && <p class="also"><span class="mono">{t.alsoLabel}</span> {term.also}</p>}
          {term.text.map((para) => <p>{para}</p>)}
          {term.view && <a class="see-it" href={`${routes.explorer}#${term.view}`}>{t.seeIt}</a>}
        </section>
      ))}
    </div>

    <aside class="next">
      <p>{t.nextBefore} <a href={routes.prep}>{t.nextLink}</a>{t.nextAfter}</p>
      <p class="sources">{t.sourcesBefore} <a href={routes.evidence}>{t.sourcesLink}</a>.</p>
    </aside>
    <NextStep from="mri" />
  </div>
</Base>

<style>
  .mri {
    padding-top: var(--s-56);
    padding-bottom: var(--s-72);
    max-width: 50rem;
  }
  .page-intro h1 {
    font-size: var(--h1-page);
    line-height: 1.08;
    margin-bottom: var(--s-16);
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    margin: 0 0 var(--s-12);
  }
  .note {
    margin: 0;
    padding: var(--s-12) var(--s-16);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    font-size: var(--text-small);
  }
  .mri-view {
    margin: var(--s-32) 0 var(--s-16);
    padding-top: var(--s-16);
    border-top: 2px solid var(--ink);
  }
  .mri-view h2 {
    font-size: var(--h2-section);
    margin: 0 0 var(--s-8);
  }
  .mri-view > p {
    max-width: 40em;
    margin: 0 0 var(--s-16);
  }
  .mri-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-24);
    align-items: start;
  }
  .mri-figure {
    margin: 0;
  }
  .mri-image {
    position: relative;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .mri-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .mri-marker {
    position: absolute;
    transform: translate(-50%, -50%);
    min-width: 26px;
    height: 26px;
    padding: 0 4px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1f5f8b;
    border: 2px solid #ffffff;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
  }
  .mri-figure figcaption {
    margin-top: var(--s-8);
    font-size: var(--text-small);
    color: var(--ink-2);
  }
  .mri-legend ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .mri-legend li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--s-12);
    padding: 6px 0;
    border-bottom: 1px solid var(--rule);
  }
  .mri-num {
    color: var(--muted);
    font-size: var(--text-mono);
    min-width: 2ch;
  }
  .mri-name {
    flex: 1;
    font-weight: 600;
  }
  .mri-legend a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .mri-note,
  .mri-credit {
    margin: var(--s-12) 0 0;
    font-size: var(--text-small);
    color: var(--ink-2);
  }
  .mri-credit {
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .mri-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .term-index {
    margin: var(--s-32) 0 var(--s-24);
  }
  .index-title {
    font-size: var(--text-mono);
    font-weight: 400;
    color: var(--muted);
    margin: 0 0 var(--s-8);
  }
  .term-index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-16);
  }
  .term-index a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .terms {
    margin-top: var(--s-16);
    border-top: 2px solid var(--ink);
  }
  .term {
    padding: var(--s-24) 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: var(--s-16);
  }
  .term-name {
    font-size: 24px;
    line-height: 1.2;
    margin: 0 0 var(--s-8);
  }
  .also {
    margin: 0 0 var(--s-8);
    color: var(--ink-2);
    font-size: var(--text-small);
  }
  .also .mono {
    color: var(--muted);
    font-size: var(--text-mono);
  }
  .term p {
    max-width: 40em;
    margin: 0 0 var(--s-8);
  }
  .see-it {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-weight: 600;
  }
  .next {
    margin-top: var(--s-32);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .next p {
    margin: 0;
  }
  .sources {
    font-size: var(--text-small);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .page-intro h1 {
      font-size: var(--h1-page);
    }
  }
  :global(:root[data-calm='on']) .term p {
    font-size: 19px;
  }
</style>
