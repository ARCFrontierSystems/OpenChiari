---
/**
 * Doctor visit prep. Layout from design/mockups/Prep.dc.html (desktop), PrepPhone.dc.html (phone)
 * and PrepSheet.dc.html (the printed sheet). All text from src/i18n/en.json, word for word from docs/COPY.md.
 *
 * Privacy: everything happens in this page. Nothing is stored (no localStorage, no cookies) and
 * nothing is sent: there is no form submission and no network request. tests/site.spec.ts checks this.
 */
import Base from '../layouts/Base.astro';
import AnatomyFigure from '../components/AnatomyFigure.astro';
import { getStrings, getRoutes } from '../i18n';

const t = getStrings(Astro.currentLocale).prep;
const r = getRoutes(Astro.currentLocale);
const f = getStrings(Astro.currentLocale).footer;
// The model credit exactly as CLAUDE.md rule 3 gives it (from the footer's pieces).
const credit = `${f.modelBefore.replace(/^\.\s*/, '')} ${f.zAnatomy} ${f.modelAfter}`;
const all = t.groups.flatMap((g) => g.questions);
const selected = all.filter((q) => q.checked);
const count = (forms: { one: string; other: string }, n: number) => (n === 1 ? forms.one : forms.other.replace('{n}', String(n)));
---

<Base title={t.title}>
  <div class="prep container">
    <div class="prep-intro">
      <h1 class="serif">{t.title}</h1>
      <p><span class="only-wide">{t.intro.wide}</span><span class="only-narrow">{t.intro.narrow}</span></p>
    </div>

    <div class="prep-layout">
      <form class="prep-form" aria-label={t.formLabel} data-prep-form autocomplete="off">
        {t.groups.map((g, i) => (
          <details class="group" data-group={g.id} data-collapse-on-phone={i >= 2 ? '' : undefined} open={!('folded' in g && g.folded)} data-folded={'folded' in g && g.folded ? '' : undefined}>
            <summary>
              <span class="group-title">{g.title}</span>
              <span class:list={['group-count', { 'only-narrow': !('folded' in g && g.folded) }]} aria-hidden="true">{'\u00A0· ' + g.questions.length}</span>
            </summary>
            <fieldset>
              <legend class="visually-hidden">{g.title}</legend>
              {g.questions.map((q) => (
                <label class="question">
                  <input type="checkbox" data-question={q.id} data-text={q.text} checked={q.checked} />
                  <span>
                    {'narrow' in q ? (
                      <>
                        <span class="only-wide">{q.text}</span>
                        <span class="only-narrow">{q.narrow}</span>
                      </>
                    ) : (
                      q.text
                    )}
                  </span>
                </label>
              ))}
            </fieldset>
          </details>
        ))}

        <p class="child-link">{t.child.before} <a href={r.children}>{t.child.link}</a>{t.child.after}</p>

        <div class="own">
          <label for="own-question" class="field-label">{t.addOwn}</label>
          <div class="own-row">
            <input id="own-question" type="text" autocomplete="off" maxlength="200" data-own-input />
            <button type="button" class="button button-secondary" data-own-add>{t.add}</button>
          </div>
          <div class="own-list" data-own-list></div>

          <label for="mention" class="field-label">{t.mention}</label>
          <div class="own-row">
            <input id="mention" type="text" autocomplete="off" maxlength="200" data-mention-input />
            <button type="button" class="button button-secondary" data-mention-add>{t.add}</button>
          </div>
          <div class="own-list" data-mention-list></div>
        </div>
      </form>

      <aside class="sheet-side" aria-label={t.sheetTitle}>
        <div class="preview only-wide">
          <p class="preview-count mono" data-sheet-count aria-live="polite">{count(t.sheetCount, selected.length)}</p>
          <h2 class="serif">{t.sheetTitle}</h2>
          <ol data-preview-list>
            {selected.map((q) => <li>{q.text}</li>)}
          </ol>
          <div class="preview-mention" data-preview-mention-wrap hidden>
            <h3>{t.mention}</h3>
            <ul data-preview-mention></ul>
          </div>
          <p class="preview-note">{t.answerSpace}</p>
        </div>

        <div class="actions">
          <p class="selected-count mono only-narrow" data-selected-count aria-live="polite">{count(t.selectedCount, selected.length)}</p>
          <div class="action-buttons">
            <button type="button" class="button button-primary" data-print>
              <span class="only-wide">{t.print}</span><span class="only-narrow">{t.previewPrint}</span>
            </button>
            <button type="button" class="button button-secondary" data-print>{t.pdf}</button>
          </div>
          <label class="diagram-option">
            <input type="checkbox" data-diagram checked />
            {t.diagram}
          </label>
        </div>
      </aside>
    </div>

    <section class="pack" aria-labelledby="pack-title" data-pack>
      <h2 id="pack-title" class="serif">{t.pack.title}</h2>
      <p>{t.pack.intro}</p>
      <fieldset>
        <legend class="visually-hidden">{t.pack.formLabel}</legend>
        {t.pack.items.map((item) => (
          <label class="question">
            <input type="checkbox" data-pack-item={item} checked />
            <span>{item}</span>
          </label>
        ))}
      </fieldset>
      <div class="own pack-own">
        <label for="pack-own" class="field-label">{t.pack.addOwn}</label>
        <div class="own-row">
          <input id="pack-own" type="text" autocomplete="off" maxlength="120" data-pack-input />
          <button type="button" class="button button-secondary" data-pack-add>{t.add}</button>
        </div>
        <div class="own-list" data-pack-own-list></div>
      </div>
      <button type="button" class="button button-secondary" data-print-pack>{t.pack.print}</button>
    </section>

    <p class="page-note">{t.pageNote}</p>
  </div>

  <!-- The printed packing list: printed only from its own button. -->
  <section class="print-pack" aria-hidden="true" data-print-pack-sheet>
    <h1 class="serif">{t.pack.title}</h1>
    <p>{t.pack.intro}</p>
    <ul data-pack-sheet-list>
      {t.pack.items.map((item) => <li>{item}</li>)}
    </ul>
    <p class="sheet-footer mono">{t.sheetFooter}</p>
  </section>

  <!-- The printed sheet (PrepSheet mockup). Hidden on screen; it is the only thing that prints. -->
  <section class="print-sheet" aria-hidden="true" data-print-sheet>
    <div class="sheet-head">
      <div class="sheet-title">
        <h1 class="serif">{t.sheetTitle}</h1>
        <p>{t.sheetMeta}</p>
      </div>
      <figure class="sheet-diagram" data-sheet-diagram>
        <AnatomyFigure condition="chiari" flow={false} labels={false} measure={true} />
        <figcaption>{t.diagramCaption}</figcaption>
      </figure>
    </div>
    <ol class="sheet-questions" data-sheet-list>
      {selected.map((q) => <li>{q.text}<div class="answer"></div></li>)}
    </ol>
    <div class="sheet-mention">
      <h2>{t.mention}</h2>
      <ul class="sheet-mention-list" data-sheet-mention></ul>
      <div class="line"></div>
      <div class="line"></div>
    </div>
    <p class="sheet-footer mono">{t.sheetFooter}</p>
    <p class="sheet-credit">{credit}</p>
  </section>
</Base>

<script>
  import strings from '../i18n/client';

  const t = strings.prep;
  const form = document.querySelector<HTMLFormElement>('[data-prep-form]')!;
  const ownInput = document.querySelector<HTMLInputElement>('[data-own-input]')!;
  const ownList = document.querySelector<HTMLElement>('[data-own-list]')!;
  const mentionInput = document.querySelector<HTMLInputElement>('[data-mention-input]')!;
  const mentionList = document.querySelector<HTMLElement>('[data-mention-list]')!;
  const diagram = document.querySelector<HTMLInputElement>('[data-diagram]')!;
  const count = (forms: { one: string; other: string }, n: number) => (n === 1 ? forms.one : forms.other.replace('{n}', String(n)));

  // Nothing is ever submitted anywhere.
  form.addEventListener('submit', (e) => e.preventDefault());

  // On phones, groups after the first two start collapsed (PrepPhone mockup).
  if (window.matchMedia('(max-width: 720px)').matches) {
    form.querySelectorAll<HTMLDetailsElement>('details[data-collapse-on-phone]').forEach((d) => (d.open = false));
  }

  /** The chosen questions, in order: the listed ones, then the visitor's own. */
  function chosen(): string[] {
    return Array.from(form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-text]'))
      .filter((box) => box.checked)
      .map((box) => box.dataset.text!);
  }

  /** Adds what was typed as a ticked item (untick to leave it off the sheet). kind: a question, a thing to mention, or
   *  something to pack. */
  function addItem(input: HTMLInputElement, list: HTMLElement, kind: 'text' | 'mention' | 'packItem') {
    const text = input.value.trim();
    if (!text) return;
    const label = document.createElement('label');
    label.className = 'question';
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.checked = true;
    box.dataset[kind] = text;
    const span = document.createElement('span');
    span.textContent = text; // text only: never interpreted as HTML
    label.append(box, span);
    list.append(label);
    input.value = '';
    input.focus();
    update();
  }
  for (const [input, list, button, kind] of [
    [ownInput, ownList, '[data-own-add]', 'text'],
    [mentionInput, mentionList, '[data-mention-add]', 'mention'],
    [document.querySelector<HTMLInputElement>('[data-pack-input]')!, document.querySelector<HTMLElement>('[data-pack-own-list]')!, '[data-pack-add]', 'packItem'],
  ] as const) {
    document.querySelector(button)!.addEventListener('click', () => addItem(input, list, kind));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addItem(input, list, kind);
      }
    });
  }

  function fillList(list: HTMLOListElement, items: string[], withAnswers: boolean) {
    list.replaceChildren(
      ...items.map((text) => {
        const li = document.createElement('li');
        li.textContent = text;
        if (withAnswers) {
          const answer = document.createElement('div');
          answer.className = 'answer';
          li.append(answer);
        }
        return li;
      }),
    );
  }

  const sheet = document.querySelector<HTMLElement>('[data-print-sheet]')!;
  function update() {
    const items = chosen();
    fillList(document.querySelector('[data-preview-list]')!, items, false);
    fillList(document.querySelector('[data-sheet-list]')!, items, true);
    document.querySelector('[data-sheet-count]')!.textContent = count(t.sheetCount, items.length);
    document.querySelector('[data-selected-count]')!.textContent = count(t.selectedCount, items.length);
    const mentions = Array.from(mentionList.querySelectorAll<HTMLInputElement>('input[data-mention]'))
      .filter((box) => box.checked)
      .map((box) => box.dataset.mention!);
    document.querySelector('[data-sheet-mention]')!.replaceChildren(
      ...mentions.map((text) => Object.assign(document.createElement('li'), { textContent: text })),
    );
    // The on-screen preview shows them too.
    document.querySelector('[data-preview-mention]')!.replaceChildren(
      ...mentions.map((text) => Object.assign(document.createElement('li'), { textContent: text })),
    );
    document.querySelector<HTMLElement>('[data-preview-mention-wrap]')!.hidden = mentions.length === 0;
    sheet.classList.toggle('no-diagram', !diagram.checked);
    // Keep the sheet on one page: less answer space as the list grows.
    sheet.dataset.density = items.length <= 7 ? 'roomy' : items.length <= 10 ? 'medium' : 'tight';
  }
  form.addEventListener('change', update);
  diagram.addEventListener('change', update);
  update();

  // Print sheet, Preview and print, and Save as PDF all open the browser's print window,
  // which shows a preview and offers "Save as PDF".
  document.querySelectorAll('[data-print]').forEach((b) =>
    b.addEventListener('click', () => {
      update();
      window.print();
    }),
  );

  // The packing list prints on its own sheet, with only the ticked items.
  const root = document.documentElement;
  document.querySelector('[data-print-pack]')!.addEventListener('click', () => {
    const items = Array.from(document.querySelectorAll<HTMLInputElement>('[data-pack-item]'))
      .filter((box) => box.checked)
      .map((box) => box.dataset.packItem!);
    document.querySelector('[data-pack-sheet-list]')!.replaceChildren(
      ...items.map((text) => Object.assign(document.createElement('li'), { textContent: text })),
    );
    root.dataset.printing = 'pack';
    window.print();
  });
  window.addEventListener('afterprint', () => delete root.dataset.printing);
</script>

<style>
  .prep {
    padding-top: var(--s-56);
    padding-bottom: var(--s-72);
    display: flex;
    flex-direction: column;
    gap: var(--s-32);
  }
  .prep-intro {
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prep-intro h1 {
    font-size: 42px;
    line-height: 1.1;
  }
  .prep-intro p {
    color: var(--ink-2);
  }
  .prep-layout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-48);
    align-items: flex-start;
  }
  .prep-form {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Question groups */
  .group {
    border-top: 1px solid var(--rule);
    padding-top: 14px;
  }
  .group:first-child {
    border-top: 2px solid var(--ink);
  }
  .group summary {
    list-style: none;
    font-weight: 600;
    font-size: 18px;
    padding-bottom: 6px;
    min-height: var(--touch);
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .group summary::-webkit-details-marker {
    display: none;
  }
  .group-count {
    font-weight: 400;
    color: var(--muted);
  }
  .group[open] .group-count {
    display: none;
  }
  .group[data-folded] summary::after {
    content: '+';
    margin-left: auto;
    font-weight: 400;
    font-size: 1.3em;
    line-height: 1;
  }
  .group[data-folded][open] summary::after {
    content: '\2212';
  }
  .group fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
  }
  .question,
  .own-list :global(.question) {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-height: var(--touch);
    padding: 8px 0;
    cursor: pointer;
  }
  .question input,
  .own-list :global(.question input) {
    accent-color: var(--accent);
    margin: 3px 0 0;
    width: 20px;
    height: 20px;
    flex: none;
  }

  /* Own question and notes */
  .own {
    border-top: 1px solid var(--rule);
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field-label {
    font-weight: 600;
    font-size: 18px;
  }
  .field-label + textarea,
  .own-list + .field-label {
    margin-top: 0;
  }
  .own-list + .field-label {
    margin-top: 12px;
  }
  .own-row {
    display: flex;
    gap: 8px;
  }
  .own-row input,
  .own textarea {
    flex: 1 1 auto;
    min-height: var(--touch);
    padding: 0 12px;
    border: 1px solid var(--input-border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: 400 16px var(--font-sans);
  }
  .own textarea {
    width: 100%;
    padding: 10px 12px;
    line-height: 1.5;
    resize: vertical;
  }
  .own-row .button {
    min-height: var(--touch);
    padding: 0 18px;
    background: var(--surface);
    font: 500 15px var(--font-sans);
  }

  /* Sheet preview and actions */
  .sheet-side {
    flex: 1 1 340px;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: var(--s-16);
    position: sticky;
    top: var(--s-24);
  }
  .preview {
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: var(--s-24);
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
  }
  .preview-count,
  .selected-count {
    font-size: 12px;
    color: var(--muted);
  }
  .preview h2 {
    font-size: 20px;
  }
  .preview ol {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .preview-note {
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .action-buttons {
    display: flex;
    gap: 8px;
  }
  .action-buttons .button {
    flex: 1 1 0;
    font: 500 15px var(--font-sans);
    cursor: pointer;
  }
  .action-buttons .button-secondary {
    background: var(--surface);
  }
  .diagram-option {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--touch);
    font-size: 14px;
    cursor: pointer;
  }
  .diagram-option input {
    accent-color: var(--accent);
    margin: 0;
    width: 20px;
    height: 20px;
  }
  .page-note {
    font-size: 14px;
    color: var(--muted);
  }
  .child-link {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .pack {
    max-width: 700px;
    border-top: 2px solid var(--ink);
    padding-top: var(--s-16);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pack h2 {
    font-size: 28px;
  }
  .pack p {
    color: var(--ink-2);
  }
  .pack fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
  }
  .pack-own {
    margin-top: 4px;
  }
  .pack > .button {
    margin-top: 8px;
  }
  .pack .button {
    align-self: flex-start;
    background: var(--surface);
    font: 500 15px var(--font-sans);
    cursor: pointer;
  }

  /* ---------- Phone (PrepPhone mockup) ---------- */
  @media (max-width: 720px) {
    .prep {
      padding-top: 28px;
      padding-bottom: 0;
      gap: var(--s-16);
    }
    .prep-intro h1 {
      font-size: 30px;
      line-height: 1.15;
    }
    .prep-layout {
      flex-direction: column;
      gap: var(--s-20);
    }
    .prep-form {
      flex: none;
      width: 100%;
      gap: 0;
    }
    .group {
      padding: 4px 0;
    }
    .group summary {
      font-size: 17px;
      padding: 6px 0;
    }
    .question {
      padding: 10px 0;
    }
    .own {
      margin-top: var(--s-12);
    }
    .field-label {
      font-size: 16px;
    }
    .group[open] .group-count {
      display: none;
    }
    .sheet-side {
      flex: none;
      position: sticky;
      bottom: 0;
      top: auto;
      max-width: none;
      width: calc(100% + 2 * var(--gutter));
      margin: 0 calc(-1 * var(--gutter));
      padding: var(--s-16) var(--gutter) var(--s-16);
      background: var(--surface);
      border-top: 1px solid var(--rule);
      z-index: 2;
    }
    .actions {
      gap: 10px;
    }
    .diagram-option {
      min-height: 32px;
    }
    .page-note {
      padding-bottom: var(--s-24);
    }
  }

  /* ---------- Calm mode ---------- */
  .preview-mention h3 {
    margin: var(--s-16) 0 var(--s-8);
    font-size: 15px;
  }
  .preview-mention ul {
    margin: 0;
    padding-left: 1.2em;
  }
  /* Calm mode: larger buttons (DESIGN.md: at least 56 px). */
  :global(:root[data-calm='on']) .add-row .button,
  :global(:root[data-calm='on']) [data-own-add],
  :global(:root[data-calm='on']) [data-pack-add],
  :global(:root[data-calm='on']) [data-mention-add] {
    min-height: 56px;
  }
  :global(:root[data-calm='on']) .group summary,
  :global(:root[data-calm='on']) .field-label {
    font-size: 20px;
  }
  :global(:root[data-calm='on']) .preview,
  :global(:root[data-calm='on']) .diagram-option,
  :global(:root[data-calm='on']) .page-note {
    font-size: 16px;
  }

  /* ---------- The printed sheet (PrepSheet mockup) ---------- */
  .print-sheet,
  .print-pack {
    display: none;
  }
  @media print {
    @page {
      margin: 14mm 16mm;
    }
    :global(body > *:not(main)),
    :global(main > *:not(.print-sheet):not(.print-pack)),
    :global(.skip-link) {
      display: none !important;
    }
    :global(body) {
      background: #ffffff !important;
    }
    :global(:root[data-printing='pack']) .print-sheet {
      display: none !important;
    }
    :global(:root[data-printing='pack']) .print-pack {
      display: flex;
      flex-direction: column;
      gap: 12px;
      color: #1c1d21;
      font-family: var(--font-sans);
      font-size: 12pt;
    }
    .print-pack h1 {
      font-size: 24pt;
      border-bottom: 2px solid #1c1d21;
      padding-bottom: 10px;
    }
    .print-pack ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .print-pack :global(li)::before {
      content: '';
      display: inline-block;
      width: 12px;
      height: 12px;
      margin-right: 10px;
      border: 1.5px solid #1c1d21;
      vertical-align: -1px;
    }
    .print-sheet {
      display: flex;
      flex-direction: column;
      gap: 16px;
      color: #1c1d21;
      font-family: var(--font-sans);
      font-size: 11.5pt;
      line-height: 1.4;
      --answer: 34px;
      --gap: 12px;
    }
    .print-sheet[data-density='medium'] {
      --answer: 20px;
      --gap: 8px;
    }
    .print-sheet[data-density='tight'] {
      --answer: 10px;
      --gap: 5px;
      font-size: 10.5pt;
    }
    .sheet-head {
      display: flex;
      gap: 32px;
      align-items: flex-start;
      border-bottom: 2px solid #1c1d21;
      padding-bottom: 16px;
    }
    .sheet-title {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .sheet-title h1 {
      font-size: 24pt;
    }
    .sheet-title p {
      font-size: 10.5pt;
      color: #5e5f66;
    }
    .sheet-diagram {
      width: 104px;
      flex: none;
      border: 1px solid #dcdbd6;
    }
    .sheet-diagram figcaption {
      padding: 2px 4px;
